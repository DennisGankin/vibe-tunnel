# vibe-tunnel container: Claude Code in a plain Ubuntu with the tooling a
# research code base needs. Derived from euler-vibe's claude-mobile.def, minus
# the Happy/Codex parts. Build from the repository root (see setup.sh):
#   singularity build images/vibe-tunnel.sif images/vibe-tunnel.def
#
# The VS Code CLI is *not* part of the image: bin/vibe-tunnel-job bind-mounts
# the static binary from cli/code, and the VS Code server it downloads lives in
# the persistent sandbox home. Claude is installed here as a fallback only; the
# first launch installs a self-updating native build into the sandbox home
# (bin/vibe-tunnel-entry), because /usr in the image is read-only.

Bootstrap: docker
From: ghcr.io/astral-sh/uv:latest
Stage: uv_stage

Bootstrap: docker
From: ubuntu:24.04

%files from uv_stage
    # https://docs.astral.sh/uv/guides/integration/docker/#installing-uv
    /uv /bin/
    /uvx /bin/

%post
    export DEBIAN_FRONTEND=noninteractive

    # build-essential / python3-dev: compiled Python deps (numba, ...)
    # python-is-python3: tooling keeps looking for `python`
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        openssh-client \
        procps \
        python-is-python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        ripgrep \
        rsync \
        time \
        unzip \
        vim-tiny \
        zstd

    # Node.js (needed by Claude Code and by VS Code server extensions)
    # https://nodesource.com/products/distributions
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
    apt-get update && apt-get install -y --no-install-recommends nodejs

    rm -rf /var/lib/apt/lists/* && apt-get clean

    # Bundled Claude Code (fallback; the sandbox home gets a self-updating one)
    npm install -g @anthropic-ai/claude-code@latest
    npm cache clean --force

%environment
    export UV_LINK_MODE=copy
    export NODE_USE_ENV_PROXY=1

%test
    uv --version
    node --version
    claude --version

%runscript
    # Plain `singularity run image` drops into Claude in /workspace, permissions
    # skipped because Claude's own sandbox cannot run inside Apptainer.
    cd /workspace 2>/dev/null || cd /
    exec claude --dangerously-skip-permissions "$@"
