# Copy to vibe_tunnel.cfg (gitignored) and adjust. All keys are optional.
[cluster]
# ssh host or alias from your ~/.ssh/config (keys, agent, ProxyJump all apply)
host = euler
# where this repo is cloned on the cluster
remote_dir = ~/vibe-tunnel

[local]
# upload profiles/*.sbatch from this folder to ~/.vibe-tunnel/profiles on each start
sync_profiles = true
# how to open a ready tunnel: code (desktop VS Code) | browser (vscode.dev) | none
open_with = code
poll_seconds = 10
