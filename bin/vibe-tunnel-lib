# vibe-tunnel-lib -----------------------------------------------------------------
# Shared by bin/vibe-tunnel (CLI) and bin/vibe-tunnel-job (host side of a run):
# site settings, config-file validation, sandbox resolution and the Singularity
# argument list. Sourced, not executed. Expects VIBE_TUNNEL_DIR to be set.

VT_STATE_DIR=${VT_STATE_DIR:-$HOME/.vibe-tunnel}
VT_LOG_DIR=$VT_STATE_DIR/logs
VT_JOB_DIR=$VT_STATE_DIR/jobs
VT_USER_PROFILES=$VT_STATE_DIR/profiles
VT_ENV=$VT_STATE_DIR/env
VT_SITE_ENV=$VIBE_TUNNEL_DIR/site.env

# The state dir holds login tokens (sandbox home): private to the user.
if [ ! -d "$VT_STATE_DIR" ]; then mkdir -p "$VT_STATE_DIR" 2>/dev/null && chmod 700 "$VT_STATE_DIR" 2>/dev/null || true; fi

# Lab-wide defaults from the installation (site.env, kept by the maintainer),
# then the user's own settings (~/.vibe-tunnel/env, written by setup.sh), which win.
# shellcheck disable=SC1090
[ -f "$VT_SITE_ENV" ] && . "$VT_SITE_ENV"
# shellcheck disable=SC1090
[ -f "$VT_ENV" ] && . "$VT_ENV"

# A shared installation is one the user cannot write to (bin/, image, presets are
# maintained by someone else); the user's state still lives in $VT_STATE_DIR.
VT_SHARED=0; [ -w "$VIBE_TUNNEL_DIR" ] || VT_SHARED=1

# Container image: our own, or -- as a fallback for sites that already run
# euler-vibe -- its claude-mobile.sif.
EULER_VIBE_DIR=${EULER_VIBE_DIR:-}
VT_IMAGE=${VT_IMAGE:-$VIBE_TUNNEL_DIR/images/vibe-tunnel.sif}
if [ ! -e "$VT_IMAGE" ]; then
    CLAUDE_MOBILE_IMAGE=${CLAUDE_MOBILE_IMAGE:-${EULER_VIBE_DIR:+$EULER_VIBE_DIR/images/claude-mobile.sif}}
    [ -n "$CLAUDE_MOBILE_IMAGE" ] && [ -e "$CLAUDE_MOBILE_IMAGE" ] && VT_IMAGE=$CLAUDE_MOBILE_IMAGE
fi
VT_SHELLRC=${VT_SHELLRC:-$VIBE_TUNNEL_DIR/bin/vibe-tunnel-shellrc}
VT_ENTRY=$VIBE_TUNNEL_DIR/bin/vibe-tunnel-entry

# Default sandbox home: per user, under the state dir (a shared repo clone must
# not share one home). Keeps euler-vibe's when that is the image in use, so
# existing logins carry over. Override with VT_DEFAULT_HOME in $VT_ENV.
if [ -n "${VT_DEFAULT_HOME:-}" ]; then :
elif [ -n "$EULER_VIBE_DIR" ] && [ "$VT_IMAGE" = "${CLAUDE_MOBILE_IMAGE:-}" ]; then VT_DEFAULT_HOME=$EULER_VIBE_DIR/home/claude-mobile
else VT_DEFAULT_HOME=$VT_STATE_DIR/home; fi

# Saved configs live with the rest of the state. Older locations are still read:
# ~/.config/vibe-tunnel/configs (earlier vibe-tunnel) and claude-launch's dir.
VT_CONFIG_DIR=${VT_CONFIG_DIR:-$VT_STATE_DIR/configs}
VT_OLD_CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/vibe-tunnel/configs
CLAUDE_LAUNCH_CONFIG_DIR=${CLAUDE_LAUNCH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-launch/configs}
# One-time move of configs saved by earlier vibe-tunnel versions.
if [ -d "$VT_OLD_CONFIG_DIR" ] && [ ! -e "$VT_CONFIG_DIR" ] && [ "$VT_CONFIG_DIR" = "$VT_STATE_DIR/configs" ]; then
    mkdir -p "$VT_STATE_DIR" && mv "$VT_OLD_CONFIG_DIR" "$VT_CONFIG_DIR" 2>/dev/null || true
fi

VT_CODE_CLI=${VT_CODE_CLI:-$VIBE_TUNNEL_DIR/cli/code}
[ -x "$VT_CODE_CLI" ] || { [ -x "$HOME/code" ] && VT_CODE_CLI=$HOME/code; } || true

export VIBE_TUNNEL_DIR VT_STATE_DIR VT_LOG_DIR VT_SHARED VT_IMAGE VT_SHELLRC VT_DEFAULT_HOME VT_CONFIG_DIR VT_OLD_CONFIG_DIR CLAUDE_LAUNCH_CONFIG_DIR VT_CODE_CLI EULER_VIBE_DIR

# --- config files ------------------------------------------------------------------
# Only the keys we (or claude-launch) write are allowed, so a config file stays
# data rather than arbitrary code that sourcing would execute.
config_is_valid() {
    local line
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ''|'#'*) ;;
            WORKSPACE=*|MODE=*|CLAUDE_MOBILE_HOME=*|'RW_BINDS=('*|'RO_BINDS=('*|PROFILE=*|LABEL=*) ;;
            TIME=*|CPUS=*|MEM=*|GPUS=*|PARTITION=*|ACCOUNT=*) ;;
            *) return 1 ;;
        esac
    done < "$1"
}

# Validation of resource values. Memory needs a unit: slurm reads a bare number
# as megabytes, so "16" means 16 MB, not 16 GB -- the classic first-run OOM.
validate_resource() {  # validate_resource KEY VALUE -> 0 ok, else prints the reason
    local k=$1 v=$2
    case "$k" in
        MEM)  [[ "$v" =~ ^[0-9]+[KkMmGgTt]$ ]] || { printf 'memory needs a unit, e.g. 2G or 4000M (a bare number means MB to slurm)'; return 1; } ;;
        CPUS) [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -gt 0 ] || { printf 'CPUs must be a whole number'; return 1; } ;;
        TIME) [[ "$v" =~ ^([0-9]+-)?[0-9]+(:[0-9]{2}){0,2}$ ]] || { printf 'time must look like 04:00:00, 2-00:00:00 or 90 (minutes)'; return 1; } ;;
    esac
    return 0
}
# Memory string -> MB (slurm units; bare number = MB). Prints nothing if unparsable.
mem_to_mb() {
    local v=$1 n u
    [[ "$v" =~ ^([0-9]+)([KkMmGgTt]?)$ ]] || return 0
    n=${BASH_REMATCH[1]}; u=$(printf '%s' "${BASH_REMATCH[2]}" | tr '[:lower:]' '[:upper:]')
    case "$u" in K) echo $((n / 1024)) ;; ''|M) echo "$n" ;; G) echo $((n * 1024)) ;; T) echo $((n * 1024 * 1024)) ;; esac
}
# Effective value of KEY for a profile file with the current R_* overrides.
effective_value() {  # effective_value PROFILE_FILE KEY
    local f=$1 k=$2 v line
    eval "v=\${R_$k:-}"
    [ -n "$v" ] && { printf '%s' "$v"; return; }
    while IFS= read -r line; do case "$line" in "$k="*) printf '%s' "${line#*=}"; return ;; esac; done < <(profile_defaults "$f")
}

# Resource fields a config may override on top of its profile (empty = profile's value).
RESOURCE_KEYS=(TIME CPUS MEM GPUS PARTITION ACCOUNT)
# sbatch flag for each key
resource_flag() {
    case "$1" in
        TIME) printf -- '--time' ;; CPUS) printf -- '--cpus-per-task' ;; MEM) printf -- '--mem-per-cpu' ;;
        GPUS) printf -- '--gpus' ;; PARTITION) printf -- '--partition' ;; ACCOUNT) printf -- '--account' ;;
    esac
}
# Defaults from a profile's #SBATCH lines, as KEY=value lines (missing keys omitted).
profile_defaults() {
    awk '
        /^#SBATCH/ {
            for (i = 2; i <= NF; i++) {
                split($i, kv, "=")
                if (kv[1] == "--time") print "TIME=" kv[2]
                else if (kv[1] == "--cpus-per-task") print "CPUS=" kv[2]
                else if (kv[1] == "--mem-per-cpu") print "MEM=" kv[2]
                else if (kv[1] == "--gpus") print "GPUS=" kv[2]
                else if (kv[1] == "--partition") print "PARTITION=" kv[2]
                else if (kv[1] == "--account") print "ACCOUNT=" kv[2]
            }
        }' "$1"
}
# One-line human summary of effective resources: profile defaults overridden by
# the R_* variables (R_TIME, R_CPUS, ...). Overridden values are marked with *.
resources_summary() {
    local f=$1 k v line d
    declare -a def=()
    while IFS= read -r line; do def+=("$line"); done < <(profile_defaults "$f")
    local out=
    for k in "${RESOURCE_KEYS[@]}"; do
        d=; for line in "${def[@]+"${def[@]}"}"; do case "$line" in "$k="*) d=${line#*=} ;; esac; done
        eval "v=\${R_$k:-}"
        if [ -n "$v" ]; then out+="${out:+ · }$(resource_label "$k") $v*"
        elif [ -n "$d" ]; then out+="${out:+ · }$(resource_label "$k") $d"
        fi
    done
    printf '%s' "$out"
}
resource_label() {
    case "$1" in TIME) printf time ;; CPUS) printf cpus ;; MEM) printf mem/cpu ;; GPUS) printf gpus ;; PARTITION) printf partition ;; ACCOUNT) printf account ;; esac
}

# Per-run settings file written by the CLI for the job/run script.
env_is_valid() {
    local line
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ''|'#'*) ;;
            VT_TUNNEL_NAME=*|VT_CONFIG=*|VT_CONFIG_FILE=*|VT_WORKSPACE=*|VT_HOME=*|VT_EXTENSIONS=*|'VT_RW_BINDS=('*|'VT_RO_BINDS=('*) ;;
            *) return 1 ;;
        esac
    done < "$1"
}

config_field() {  # config_field FILE VAR
    ( set +eu; . "$1" >/dev/null 2>&1; printf '%s' "${!2:-}" )
}

# Tunnel names: VS Code allows lowercase letters, digits and hyphens, max 20 chars.
sanitize_name() {
    local n
    n=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | sed 's/^-*//; s/-*$//; s/--*/-/g')
    printf '%s' "${n:0:20}"
}

# Write the current setup (WORKSPACE, MODE, CLAUDE_MOBILE_HOME, PROFILE, LABEL,
# R_* overrides, RW_BINDS, RO_BINDS) as a config file. Used by the menu and the CLI.
write_config_file() {  # write_config_file PATH NAME
    local f=$1 name=$2 b
    mkdir -p "$(dirname "$f")"
    {
        printf '# vibe-tunnel config: %s\n' "$name"
        printf '# saved %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        printf 'WORKSPACE=%q\n' "$WORKSPACE"
        printf 'MODE=%q\n' "${MODE:-tunnel}"
        printf 'CLAUDE_MOBILE_HOME=%q\n' "$CLAUDE_MOBILE_HOME"
        printf 'PROFILE=%q\n' "${PROFILE:-}"
        printf 'LABEL=%q\n' "${LABEL:-}"
        printf 'TIME=%q\nCPUS=%q\nMEM=%q\nGPUS=%q\nPARTITION=%q\nACCOUNT=%q\n' "${R_TIME:-}" "${R_CPUS:-}" "${R_MEM:-}" "${R_GPUS:-}" "${R_PARTITION:-}" "${R_ACCOUNT:-}"
        printf 'RW_BINDS=('; for b in "${RW_BINDS[@]+"${RW_BINDS[@]}"}"; do printf ' %q' "$b"; done; printf ' )\n'
        printf 'RO_BINDS=('; for b in "${RO_BINDS[@]+"${RO_BINDS[@]}"}"; do printf ' %q' "$b"; done; printf ' )\n'
    } > "$f"
}

# Path of a saved config by name: own dir first, then the older locations.
find_config() {
    local n=$1 d
    for d in "$VT_CONFIG_DIR" "$VT_OLD_CONFIG_DIR" "$CLAUDE_LAUNCH_CONFIG_DIR"; do
        [ -f "$d/$n.conf" ] && { printf '%s' "$d/$n.conf"; return; }
    done
    return 1
}

# --- sandbox resolution ------------------------------------------------------------
# Input: VT_CONFIG_FILE (optional) and VT_WORKSPACE/VT_HOME/VT_RW_BINDS/VT_RO_BINDS
# overrides. Output: WORKSPACE, CLAUDE_MOBILE_HOME, RW_BINDS, RO_BINDS (arrays).
vt_resolve_sandbox() {
    WORKSPACE= CLAUDE_MOBILE_HOME= RW_BINDS=() RO_BINDS=() MODE= PROFILE= LABEL=
    if [ -n "${VT_CONFIG_FILE:-}" ]; then
        [ -f "$VT_CONFIG_FILE" ] || { echo "config file not found: $VT_CONFIG_FILE" >&2; return 1; }
        config_is_valid "$VT_CONFIG_FILE" || { echo "config has unexpected content: $VT_CONFIG_FILE" >&2; return 1; }
        # shellcheck disable=SC1090
        . "$VT_CONFIG_FILE"
    fi
    WORKSPACE=${VT_WORKSPACE:-${WORKSPACE:-$HOME}}
    CLAUDE_MOBILE_HOME=${VT_HOME:-${CLAUDE_MOBILE_HOME:-$VT_DEFAULT_HOME}}
    RW_BINDS+=("${VT_RW_BINDS[@]+"${VT_RW_BINDS[@]}"}")
    RO_BINDS+=("${VT_RO_BINDS[@]+"${VT_RO_BINDS[@]}"}")
}

# --- container invocation (mirrors euler-vibe/bin/claude-mobile) -------------------
# Fills CONTAINER_ARGS for `singularity exec`. Needs WORKSPACE, CLAUDE_MOBILE_HOME,
# RW_BINDS, RO_BINDS and VT_TMPDIR. Extra --bind/--env can be appended by the caller.
vt_container_args() {
    # The workspace keeps its cluster path inside the container, so absolute
    # paths in scripts, symlinks, environments and Claude's per-project memory
    # stay valid; /workspace is a second mount of the same directory.
    CONTAINER_ARGS=(
        --nv
        --cleanenv
        --containall
        --home "$CLAUDE_MOBILE_HOME:/home"
        --bind "$WORKSPACE:$WORKSPACE"
        --bind "$WORKSPACE:/workspace"
        --bind "$VT_TMPDIR:/tmp"
        --bind "$VT_ENTRY:/opt/vibe-tunnel/entry:ro"
        --bind "$VT_SHELLRC:/opt/vibe-tunnel/shellrc:ro"
    )
    [ -x "$VT_CODE_CLI" ] && CONTAINER_ARGS+=(--bind "$VT_CODE_CLI:/opt/vibe-tunnel/code:ro")
    # The VS Code tunnel login belongs to the user, not to a sandbox home: keep it
    # in the (private) state dir and mount it into every container, so the GitHub
    # device login happens once per user rather than once per home.
    VT_VSCODE_AUTH=${VT_VSCODE_AUTH:-$VT_STATE_DIR/vscode-auth}
    mkdir -p "$VT_VSCODE_AUTH" 2>/dev/null && chmod 700 "$VT_VSCODE_AUTH" 2>/dev/null || true
    [ -d "$VT_VSCODE_AUTH" ] && CONTAINER_ARGS+=(--bind "$VT_VSCODE_AUTH:/opt/vibe-tunnel/vscode-auth")
    # Apptainer bind syntax is SRC[:DEST[:OPTS]]; options need all three fields,
    # so a bare SRC must become SRC:SRC:ro (SRC:ro would mean "mount at ./ro").
    local b spec
    for b in "${RW_BINDS[@]+"${RW_BINDS[@]}"}"; do CONTAINER_ARGS+=(--bind "${b%:rw}"); done
    for b in "${RO_BINDS[@]+"${RO_BINDS[@]}"}"; do
        spec=${b%:ro}; spec=${spec%:rw}
        case "$spec" in
            *:*) CONTAINER_ARGS+=(--bind "$spec:ro") ;;      # SRC:DEST
            *)   CONTAINER_ARGS+=(--bind "$spec:$spec:ro") ;; # SRC -> same path
        esac
    done
}

# Forward proxy settings through --cleanenv (both spellings, both prefixes), and
# make Node honour them. Extra KEY=VALUE pairs are passed into the container too.
vt_container_env() {
    local proxy_var upper val kv
    for proxy_var in http_proxy https_proxy all_proxy no_proxy; do
        upper=$(printf '%s' "$proxy_var" | tr '[:lower:]' '[:upper:]')
        val=${!proxy_var:-${!upper:-}}
        if [ -n "$val" ]; then
            export "SINGULARITYENV_${proxy_var}=$val" "SINGULARITYENV_${upper}=$val"
            export "APPTAINERENV_${proxy_var}=$val"   "APPTAINERENV_${upper}=$val"
        fi
    done
    export SINGULARITYENV_NODE_USE_ENV_PROXY=1 APPTAINERENV_NODE_USE_ENV_PROXY=1
    for kv in "$@"; do export "SINGULARITYENV_$kv" "APPTAINERENV_$kv"; done
}

vt_singularity() { command -v singularity || command -v apptainer || true; }
