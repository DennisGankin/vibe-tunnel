#!/usr/bin/env bash
set -euo pipefail

# vibe-tunnel-launch ---------------------------------------------------------
# Interactive front-end for `vibe-tunnel submit`, run on the cluster (directly
# on a login node, or from the laptop client over `ssh -t`). Arrow-key menu that
# shows the whole setup at once -- workspace, sandbox home, extra read-only /
# read-write directories (Tab completion), resource profile, tunnel label --
# lets you save/reuse it as a named config, then submits the job and waits for
# the tunnel link -- or, in mode claude/shell, runs the container right here.
# Adapted from euler-vibe's claude-launch (MIT, jurgjn).
#
#   vibe-tunnel launch [--config NAME] [--no-wait]
#
# Running tunnels are listed at the top; "Reopen a running tunnel" picks one
# instead of submitting. --no-wait returns right after a submission or reopen
# (the laptop client waits itself so it can open VS Code locally); the chosen
# job is recorded in $VT_STATE_DIR/last-job either way.

VT_LAUNCH_BIN=$(realpath "$0")
VIBE_TUNNEL_DIR=${VIBE_TUNNEL_DIR:-$(dirname "$(dirname "$VT_LAUNCH_BIN")")}
VT=$VIBE_TUNNEL_DIR/bin/vibe-tunnel
# shellcheck disable=SC1091
. "$VIBE_TUNNEL_DIR/bin/vibe-tunnel-lib"

MODE=tunnel
WORKSPACE=$(pwd)
CLAUDE_MOBILE_HOME=${VT_DEFAULT_HOME:-}
PROFILE=
LABEL=
# Resource overrides on top of the profile (empty = the profile's value).
R_TIME= R_CPUS= R_MEM= R_GPUS= R_PARTITION= R_ACCOUNT=
RW_BINDS=()
RO_BINDS=()
NO_WAIT=0
PRELOAD=

while [ $# -gt 0 ]; do
    case "$1" in
        --no-wait) NO_WAIT=1 ;;
        --config)  shift; PRELOAD=${1:-} ;;
        -h|--help) sed -n '4,16p' "$VT_LAUNCH_BIN" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "vibe-tunnel launch: unknown option $1" >&2; exit 1 ;;
    esac
    shift
done

# --- colors / terminal control --------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'; DIM=$'\033[2m'; RST=$'\033[0m'
    CYAN=$'\033[36m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'
    BLUE=$'\033[34m'; RED=$'\033[31m'; GREY=$'\033[90m'; MAG=$'\033[35m'
    EL=$'\033[K'
else
    BOLD= DIM= RST= CYAN= GREEN= YELLOW= BLUE= RED= GREY= MAG= EL=
fi

home_cur()  { printf '\033[H'; }
clr_down()  { printf '\033[0J'; }
cls()       { [ -t 1 ] && printf '\033[2J\033[3J\033[H' || true; }
show_cursor() { [ -t 1 ] && printf '\033[?25h' || true; }
hide_cursor() { [ -t 1 ] && printf '\033[?25l' || true; }
trap 'show_cursor; printf "\n"' EXIT INT TERM
NEED_CLS=0
trap 'NEED_CLS=1' WINCH

term_rows() {
    local r
    r=$(tput lines 2>/dev/null) || r=""
    [ -n "$r" ] && [ "$r" -gt 0 ] 2>/dev/null || r=24
    printf '%s' "$r"
}

HEADER_MODE=home   # home: title + running tunnels · setup: the current launch setup
header_lines() {
    local rw=${#RW_BINDS[@]} ro=${#RO_BINDS[@]} run=${#RUN_IDS[@]} cap=${HEADER_BIND_CAP:-0}
    if [ "$cap" -gt 0 ]; then
        [ "$rw" -gt "$cap" ] && rw=$((cap + 1))
        [ "$ro" -gt "$cap" ] && ro=$((cap + 1))
        [ "$run" -gt "$cap" ] && run=$((cap + 1))
    fi
    if [ "$HEADER_MODE" = home ]; then
        [ "$run" -gt 0 ] || run=1
        if [ "${HEADER_COMPACT:-0}" -eq 1 ]; then printf '%s' $((2 + run)); else printf '%s' $((6 + run)); fi
        return
    fi
    [ "$rw" -gt 0 ] || rw=1
    [ "$ro" -gt 0 ] || ro=1
    if [ "${HEADER_COMPACT:-0}" -eq 1 ]; then
        printf '%s' $((8 + rw + ro))
    else
        printf '%s' $((18 + rw + ro))
    fi
}

# --- running tunnels -----------------------------------------------------------
RUN_IDS=() RUN_LABELS=() RUN_TUNNELS=()
load_running() {
    RUN_IDS=() RUN_LABELS=() RUN_TUNNELS=()
    local id name state node el left tunnel link
    while IFS='|' read -r id name state node el left tunnel link; do
        [ -n "$id" ] || continue
        RUN_IDS+=("$id"); RUN_TUNNELS+=("$tunnel")
        RUN_LABELS+=("$(printf '%-12s %-9s %-10s left %-9s job %s' "${tunnel:-(starting)}" "$state" "${node:--}" "$left" "$id")")
    done < <("$VT" status --porcelain 2>/dev/null || true)
}
print_running() {
    local cap=${HEADER_BIND_CAP:-0} total=${#RUN_IDS[@]} shown i
    if [ "$total" -eq 0 ]; then
        printf '  %sRunning tunnels%s   %s(none)%s%s\n' "$BOLD" "$RST" "$DIM" "$RST" "$EL"
        return 0
    fi
    printf '  %sRunning tunnels%s%s\n' "$BOLD" "$RST" "$EL"
    shown=$total
    [ "$cap" -gt 0 ] && [ "$shown" -gt "$cap" ] && shown=$cap
    for (( i = 0; i < shown; i++ )); do
        printf '    %s▶%s %s%s\n' "$GREEN" "$RST" "${RUN_LABELS[$i]}" "$EL"
    done
    [ "$shown" -lt "$total" ] && printf '    %s… %d more%s%s\n' "$GREY" $((total - shown)) "$RST" "$EL"
    return 0
}

# --- helpers ---------------------------------------------------------------
expand_path() {
    local p=$1
    case "$p" in
        "~") p=$HOME ;;
        "~/"*) p=$HOME/${p#"~/"} ;;
    esac
    realpath -m -- "$p" 2>/dev/null || { case "$p" in /*) printf '%s' "$p" ;; *) printf '%s/%s' "$(pwd)" "$p" ;; esac; }
}

tilde() {
    local p=$1
    case "$p" in
        "$HOME") printf '~' ;;
        "$HOME"/*) printf '~/%s' "${p#"$HOME"/}" ;;
        *) printf '%s' "$p" ;;
    esac
}

prompt_dir() {
    local label=$1 allow_missing=${2:-} reply
    show_cursor
    read -e -r -p "$(printf '%s%s%s (Tab completes, empty to cancel): ' "$BOLD" "$label" "$RST")" reply || return 1
    [ -n "$reply" ] || return 1
    reply=$(expand_path "$reply")
    if [ ! -d "$reply" ] && [ -z "$allow_missing" ]; then
        printf '%s  ! Not a directory: %s%s\n' "$RED" "$reply" "$RST" >&2
        sleep 1
        return 1
    fi
    printf '%s\n' "$reply"
}

prompt_dest() {
    local src=$1 dest
    show_cursor
    read -e -r -p "  Mount inside container as [default: $src]: " dest || true
    if [ -n "${dest:-}" ]; then printf '%s:%s\n' "$src" "$dest"; else printf '%s\n' "$src"; fi
}

pause() { show_cursor; read -r -p "$(printf '%s  (press Enter to continue)%s ' "$DIM" "$RST")" _ || true; }

# --- profiles ----------------------------------------------------------------
PROFILE_NAMES=() PROFILE_PATHS=() PROFILE_SUMMARIES=()
load_profiles() {
    PROFILE_NAMES=() PROFILE_PATHS=() PROFILE_SUMMARIES=()
    local n f s
    while IFS='|' read -r n f s; do
        [ -n "$n" ] || continue
        PROFILE_NAMES+=("$n"); PROFILE_PATHS+=("$f"); PROFILE_SUMMARIES+=("$s")
    done < <("$VT" profiles --porcelain 2>/dev/null || true)
}
profile_path() {
    local i
    for i in "${!PROFILE_NAMES[@]}"; do
        [ "${PROFILE_NAMES[$i]}" = "$1" ] && { printf '%s' "${PROFILE_PATHS[$i]}"; return; }
    done
    return 1
}
# Effective resources: profile defaults with R_* overrides applied (marked *).
profile_summary() {
    local f; f=$(profile_path "$1") || { printf '%s' "(unknown profile)"; return; }
    resources_summary "$f"
}
# Effective value of one resource key for the current profile.
effective_resource() {
    local k=$1 v f line
    eval "v=\${R_$k:-}"
    [ -z "$v" ] || { printf '%s' "$v"; return; }
    f=$(profile_path "$PROFILE") || return 0
    while IFS= read -r line; do case "$line" in "$k="*) printf '%s' "${line#*=}"; return ;; esac; done < <(profile_defaults "$f")
}

# --- arrow-key menu --------------------------------------------------------
# menu_select "Prompt" "opt1" "opt2" ... -> MENU_CHOICE (0-based, -2 on q).
menu_select() {
    local prompt=$1; shift
    local options=("$@")
    local n=${#options[@]}
    local sel=${MENU_DEFAULT:-0}
    MENU_DEFAULT=0

    if [ ! -t 0 ]; then
        render_header
        echo "$prompt"
        local i=1; for o in "${options[@]}"; do printf '  %d) %s\n' "$i" "$o"; i=$((i+1)); done
        local choice; read -r -p "  Choose: " choice || { MENU_CHOICE=$((n-1)); return; }
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ]; then
            MENU_CHOICE=$((choice-1)); else MENU_CHOICE=-1; fi
        return
    fi

    hide_cursor
    local key rest i rows avail h vis start cap full=1 buf obuf
    while true; do
        if [ "$full" -eq 1 ]; then
            # Fit the frame to the window: full header, else compact header, else
            # trimmed bind lists, else a scrolling option list.
            rows=$(term_rows)
            avail=$((rows - 1))
            HEADER_COMPACT=0
            HEADER_BIND_CAP=0
            h=$(header_lines)
            if [ $((h + 3 + n)) -gt "$avail" ]; then
                HEADER_COMPACT=1
                h=$(header_lines)
            fi
            if [ $((h + 6)) -gt "$avail" ]; then
                for cap in 8 6 4 3 2 1; do
                    HEADER_BIND_CAP=$cap
                    h=$(header_lines)
                    [ $((h + 6)) -le "$avail" ] && break
                done
            fi
            vis=$((avail - h - 3))
            [ "$vis" -lt "$n" ] && vis=$((vis - 2))   # room for the ↑/↓ markers
            [ "$vis" -lt 3 ] && vis=3
            [ "$vis" -gt "$n" ] && vis=$n
            # A frame of a different shape than the previous one would leave stale
            # rows behind an in-place redraw, so clear fully whenever the shape changes.
            if [ $((h + 3 + vis + 2)) -gt "$avail" ]; then NEED_CLS=1; fi
            if [ "$h:$HEADER_COMPACT:$vis" != "${LAST_SHAPE:-}" ]; then NEED_CLS=1; LAST_SHAPE="$h:$HEADER_COMPACT:$vis"; fi
            if [ "${NEED_CLS:-0}" -eq 1 ]; then cls; NEED_CLS=0; fi
            # Header, prompt and key hint are drawn once per menu and sent as one
            # write; arrow keys then only repaint the option rows below them.
            buf=$(render_header; printf '  %s%s%s%s\n' "$DIM" "$prompt" "$RST" "$EL"
                  printf '  %s↑/↓ move · enter select · q back%s%s\n%s\n' "$GREY" "$RST" "$EL" "$EL"; printf x)
            printf '%s' "${buf%x}"
            full=0
        fi
        start=0
        if [ "$vis" -lt "$n" ]; then
            start=$((sel - vis / 2))
            [ "$start" -lt 0 ] && start=0
            [ "$start" -gt $((n - vis)) ] && start=$((n - vis))
        fi
        obuf=$(
            printf '\033[%d;1H' $((h + 4))     # first option row (1-based), just below the spacer
            [ "$start" -gt 0 ] && printf '   %s↑ %d more%s%s\n' "$GREY" "$start" "$RST" "$EL"
            for (( i = start; i < start + vis; i++ )); do
                if [ "$i" -eq "$sel" ]; then
                    printf '   %s●%s %s%s%s%s\n' "$GREEN" "$RST" "$BOLD" "${options[$i]}" "$RST" "$EL"
                else
                    printf '   %s·%s %s%s%s%s\n' "$GREY" "$RST" "$DIM" "${options[$i]}" "$RST" "$EL"
                fi
            done
            [ $((start + vis)) -lt "$n" ] && printf '   %s↓ %d more%s%s\n' "$GREY" $((n - start - vis)) "$RST" "$EL"
            clr_down; printf x)
        printf '%s' "${obuf%x}"
        IFS= read -rsn1 key || true
        # A resize (WINCH trap) invalidates the layout: redo the full frame.
        [ "${NEED_CLS:-0}" -eq 1 ] && full=1
        case "$key" in
            $'\x1b')
                # integer timeout: bash 3.2 (macOS) rejects fractional ones; the bytes
                # of an arrow key are already buffered, so this never waits in practice
                read -rsn2 -t 1 rest || true
                case "$rest" in
                    '[A') sel=$(( (sel - 1 + n) % n )) ;;
                    '[B') sel=$(( (sel + 1) % n )) ;;
                esac ;;
            k|K) sel=$(( (sel - 1 + n) % n )) ;;
            j|J) sel=$(( (sel + 1) % n )) ;;
            q|Q) MENU_CHOICE=-2; show_cursor; return ;;
            '')  MENU_CHOICE=$sel; show_cursor; return ;;
        esac
    done
}

# --- header ------------------------------------------------------------------
print_binds() {
    local color=$1; shift
    local arr=("$@")
    local cap=${HEADER_BIND_CAP:-0} total=${#arr[@]} shown i
    if [ "$total" -eq 0 ]; then
        printf '    %s(none)%s%s\n' "$DIM" "$RST" "$EL"
        return 0
    fi
    shown=$total
    [ "$cap" -gt 0 ] && [ "$shown" -gt "$cap" ] && shown=$cap
    for (( i = 0; i < shown; i++ )); do
        printf '    %s●%s %s%s\n' "$color" "$RST" "${arr[$i]}" "$EL"
    done
    if [ "$shown" -lt "$total" ]; then
        printf '    %s… %d more%s%s\n' "$GREY" $((total - shown)) "$RST" "$EL"
    fi
    return 0
}

profile_line() {
    if [ "$MODE" != tunnel ]; then printf '%s(not used: runs here, no slurm job)%s' "$DIM" "$RST"; return; fi
    if [ -n "$PROFILE" ]; then printf '%s%s%s  %s%s%s' "$MAG" "$PROFILE" "$RST" "$DIM" "$(profile_summary "$PROFILE")" "$RST"
    else printf '%s(none chosen)%s' "$RED" "$RST"; fi
}
label_line() {
    if [ "$MODE" != tunnel ]; then printf '%s(not used)%s' "$DIM" "$RST"; return; fi
    if [ -n "$LABEL" ]; then printf '%s%s%s  %s→ tunnel+%s, reused across jobs%s' "$GREEN" "$LABEL" "$RST" "$DIM" "$LABEL" "$RST"
    else printf '%s(none: vibe-<jobid>)%s' "$DIM" "$RST"; fi
}

mode_hint() {
    case "$MODE" in
        tunnel) printf 'slurm job + VS Code tunnel into the container' ;;
        claude) printf 'Claude Code in the container, in this terminal' ;;
        shell)  printf 'a shell in the container, in this terminal' ;;
    esac
}

render_header_home() {
    if [ "${HEADER_COMPACT:-0}" -eq 1 ]; then
        printf '  %s● vibe-tunnel%s%s\n' "$BOLD$GREEN" "$RST" "$EL"
        print_running
        printf '%s\n' "$EL"
        return
    fi
    printf '  %s╭──────────────────────────────────────────────────────────────────╮%s%s\n' "$CYAN" "$RST" "$EL"
    printf '  %s│%s  %s● vibe-tunnel%s   %sVS Code + Claude inside the sandbox, on a node%s  %s│%s%s\n' \
        "$CYAN" "$RST" "$BOLD$GREEN" "$RST" "$DIM" "$RST" "$CYAN" "$RST" "$EL"
    printf '  %s╰──────────────────────────────────────────────────────────────────╯%s%s\n' "$CYAN" "$RST" "$EL"
    printf '%s\n' "$EL"
    print_running
    printf '%s\n' "$EL"
}

render_header_compact() {
    printf '  %s● vibe-tunnel%s  %s·%s  %s%s%s %s%s%s%s\n' "$BOLD$GREEN" "$RST" "$DIM" "$RST" "$GREEN" "$MODE" "$RST" "$DIM" "$(mode_hint)" "$RST" "$EL"
    printf '  %sWorkspace%s %s%s%s%s\n' "$BOLD" "$RST" "$YELLOW" "$(tilde "$WORKSPACE")" "$RST" "$EL"
    printf '  %sHome%s      %s%s%s%s\n' "$BOLD" "$RST" "$CYAN" "$(tilde "$CLAUDE_MOBILE_HOME")" "$RST" "$EL"
    printf '  %sResources%s %s%s\n' "$BOLD" "$RST" "$(profile_line)" "$EL"
    printf '  %sLabel%s     %s%s\n' "$BOLD" "$RST" "$(label_line)" "$EL"
    printf '  %sRead-write dirs%s%s\n' "$BOLD" "$RST" "$EL"
    print_binds "$GREEN" "${RW_BINDS[@]+"${RW_BINDS[@]}"}"
    printf '  %sRead-only dirs%s%s\n' "$BOLD" "$RST" "$EL"
    print_binds "$BLUE" "${RO_BINDS[@]+"${RO_BINDS[@]}"}"
    printf '%s\n' "$EL"
}

render_header() {
    home_cur
    if [ "$HEADER_MODE" = home ]; then render_header_home; return; fi
    if [ "${HEADER_COMPACT:-0}" -eq 1 ]; then render_header_compact; return; fi
    printf '  %s╭──────────────────────────────────────────────────────────────────╮%s%s\n' "$CYAN" "$RST" "$EL"
    printf '  %s│%s  %s● vibe-tunnel%s   %sVS Code + Claude inside the sandbox, on a node%s  %s│%s%s\n' \
        "$CYAN" "$RST" "$BOLD$GREEN" "$RST" "$DIM" "$RST" "$CYAN" "$RST" "$EL"
    printf '  %s╰──────────────────────────────────────────────────────────────────╯%s%s\n' "$CYAN" "$RST" "$EL"
    printf '%s\n' "$EL"
    printf '  %sMode%s       %s%s%s  %s%s%s%s\n' "$BOLD" "$RST" "$GREEN" "$MODE" "$RST" "$DIM" "$(mode_hint)" "$RST" "$EL"
    printf '%s\n' "$EL"
    printf '  %sWorkspace%s  %s%s%s%s\n' "$BOLD" "$RST" "$YELLOW" "$(tilde "$WORKSPACE")" "$RST" "$EL"
    printf '             %s↳ same path in the container: VS Code opens here, Claude can read & edit%s%s\n' "$DIM" "$RST" "$EL"
    printf '%s\n' "$EL"
    printf '  %sHome%s       %s%s%s%s\n' "$BOLD" "$RST" "$CYAN" "$(tilde "$CLAUDE_MOBILE_HOME")" "$RST" "$EL"
    printf '             %s↳ persistent /home: Claude + VS Code logins, extensions, shell config%s%s\n' "$DIM" "$RST" "$EL"
    printf '%s\n' "$EL"
    printf '  %sResources%s  %s%s\n' "$BOLD" "$RST" "$(profile_line)" "$EL"
    printf '  %sLabel%s      %s%s\n' "$BOLD" "$RST" "$(label_line)" "$EL"
    printf '%s\n' "$EL"
    printf '  %sRead-write dirs%s  %s(Claude can read & write files here)%s%s\n' "$BOLD" "$RST" "$DIM" "$RST" "$EL"
    print_binds "$GREEN" "${RW_BINDS[@]+"${RW_BINDS[@]}"}"
    printf '  %sRead-only dirs%s   %s(Claude can only read from here)%s%s\n' "$BOLD" "$RST" "$DIM" "$RST" "$EL"
    print_binds "$BLUE" "${RO_BINDS[@]+"${RO_BINDS[@]}"}"
    printf '%s\n' "$EL"
}

# --- actions -----------------------------------------------------------------
build_submit_args() {
    local b
    [ "$MODE" != tunnel ] || printf '%s\n' "$PROFILE"
    printf '%s\n%s\n' "--workspace" "$WORKSPACE"
    [ -z "$CLAUDE_MOBILE_HOME" ] || printf '%s\n%s\n' "--home" "$CLAUDE_MOBILE_HOME"
    for b in "${RW_BINDS[@]+"${RW_BINDS[@]}"}"; do printf '%s\n%s\n' "--rw" "$b"; done
    for b in "${RO_BINDS[@]+"${RO_BINDS[@]}"}"; do printf '%s\n%s\n' "--ro" "$b"; done
    [ "$MODE" != tunnel ] || [ -z "$LABEL" ] || printf '%s\n%s\n' "--name" "$LABEL"
    if [ "$MODE" = tunnel ]; then
        [ -z "$R_TIME" ]      || printf '%s\n%s\n' "--time" "$R_TIME"
        [ -z "$R_CPUS" ]      || printf '%s\n%s\n' "--cpus" "$R_CPUS"
        [ -z "$R_MEM" ]       || printf '%s\n%s\n' "--mem" "$R_MEM"
        [ -z "$R_GPUS" ]      || printf '%s\n%s\n' "--gpus" "$R_GPUS"
        [ -z "$R_PARTITION" ] || printf '%s\n%s\n' "--partition" "$R_PARTITION"
        [ -z "$R_ACCOUNT" ]   || printf '%s\n%s\n' "--account" "$R_ACCOUNT"
    fi
}

review_command() {
    render_header
    printf '  %sWould run:%s%s\n' "$BOLD" "$RST" "$EL"
    if [ "$MODE" = tunnel ]; then printf '    %svibe-tunnel submit%s' "$CYAN" "$RST"; else printf '    %svibe-tunnel %s%s' "$CYAN" "$MODE" "$RST"; fi
    while IFS= read -r a; do printf ' %q' "$a"; done < <(build_submit_args)
    printf '%s\n%s\n' "$EL" "$EL"
    printf '  %sThe job then starts the container with these mounts and runs `code tunnel` inside it.%s%s\n' "$DIM" "$RST" "$EL"
    clr_down
    pause
}

remove_bind() {
    [ ${#RW_BINDS[@]} -gt 0 ] || [ ${#RO_BINDS[@]} -gt 0 ] || { render_header; echo "  (no extra binds to remove)"; clr_down; pause; return; }
    local labels=() map=() i
    for i in "${!RW_BINDS[@]}"; do labels+=("rw: ${RW_BINDS[$i]}"); map+=("w:$i"); done
    for i in "${!RO_BINDS[@]}"; do labels+=("ro: ${RO_BINDS[$i]}"); map+=("r:$i"); done
    labels+=("Cancel"); map+=("cancel")
    menu_select "Select a bind to remove:" "${labels[@]}"
    [ "${MENU_CHOICE}" -ge 0 ] 2>/dev/null || return
    local entry=${map[$MENU_CHOICE]}
    case "$entry" in
        cancel) return ;;
        w:*) local idx=${entry#w:}; unset 'RW_BINDS[idx]'; RW_BINDS=("${RW_BINDS[@]+"${RW_BINDS[@]}"}") ;;
        r:*) local idx=${entry#r:}; unset 'RO_BINDS[idx]'; RO_BINDS=("${RO_BINDS[@]+"${RO_BINDS[@]}"}") ;;
    esac
}

prompt_resource() {  # prompt_resource KEY "label" "hint"
    local k=$1 label=$2 hint=$3 cur reply
    cur=$(effective_resource "$k")
    show_cursor
    read -e -r -p "$(printf '%s%s%s [%s]  %s(Enter keeps, - resets to the profile): ' "$BOLD" "$label" "$RST" "${cur:-unset}" "$DIM$hint$RST")" reply || return
    case "$reply" in
        '') ;;
        -)  eval "R_$k=" ;;
        *)  eval "R_$k=\$reply" ;;
    esac
}

change_resources() {
    local items f
    while true; do
        load_profiles
        items=(
            "Base profile:  ${PROFILE:-(none)}"
            "Time:          $(effective_resource TIME)${R_TIME:+ *}"
            "CPUs:          $(effective_resource CPUS)${R_CPUS:+ *}"
            "Memory per CPU: $(effective_resource MEM)${R_MEM:+ *}"
            "GPUs:          $(effective_resource GPUS)${R_GPUS:+ *}"
            "Partition:     $(effective_resource PARTITION)${R_PARTITION:+ *}"
            "Account:       $(effective_resource ACCOUNT)${R_ACCOUNT:+ *}"
            "Reset all overrides to the profile's values"
            "Edit the profile file (${PROFILE:-none}) in \$EDITOR"
            "Back"
        )
        menu_select "Resources (* = overridden; saved with the config, passed to sbatch as flags):" "${items[@]}"
        case "${MENU_CHOICE}" in
            0) change_profile ;;
            1) prompt_resource TIME "Time limit" "d-hh:mm:ss, e.g. 04:00:00 or 2-00:00:00" ;;
            2) prompt_resource CPUS "CPUs" "e.g. 16" ;;
            3) prompt_resource MEM "Memory per CPU" "e.g. 2G or 4000M" ;;
            4) prompt_resource GPUS "GPUs" "e.g. a100:1, rtx_4090:4" ;;
            5) prompt_resource PARTITION "Partition" "sinfo lists them" ;;
            6) prompt_resource ACCOUNT "Account" "e.g. es_biol" ;;
            7) R_TIME= R_CPUS= R_MEM= R_GPUS= R_PARTITION= R_ACCOUNT= ;;
            8) if [ -n "$PROFILE" ]; then cls; show_cursor; "$VT" profiles edit "$PROFILE" || pause; NEED_CLS=1; fi ;;
            *) return ;;
        esac
    done
}

change_profile() {
    load_profiles
    if [ ${#PROFILE_NAMES[@]} -eq 0 ]; then
        render_header
        printf '  %sNo sbatch profiles found. Add one to %s/profiles/ or %s/profiles/.%s\n' "$RED" "$VIBE_TUNNEL_DIR" "$VT_STATE_DIR" "$RST"
        clr_down; pause; return
    fi
    local labels=() i
    for i in "${!PROFILE_NAMES[@]}"; do
        labels+=("$(printf '%-18s %s' "${PROFILE_NAMES[$i]}" "${PROFILE_SUMMARIES[$i]}")")
        [ "${PROFILE_NAMES[$i]}" = "$PROFILE" ] && MENU_DEFAULT=$i
    done
    labels+=("Cancel")
    menu_select "Pick the resources (sbatch profile) for the job:" "${labels[@]}"
    [ "${MENU_CHOICE}" -ge 0 ] 2>/dev/null || return
    [ "${MENU_CHOICE}" -lt "${#PROFILE_NAMES[@]}" ] || return
    PROFILE=${PROFILE_NAMES[$MENU_CHOICE]}
}

change_mode() {
    case "$MODE" in tunnel) MENU_DEFAULT=0 ;; claude) MENU_DEFAULT=1 ;; shell) MENU_DEFAULT=2 ;; esac
    menu_select "Pick what to launch:" \
        "tunnel  — slurm job with a VS Code tunnel into the container (default)" \
        "claude  — Claude Code in the container, right here in this terminal" \
        "shell   — plain shell in the container, right here in this terminal"
    case "${MENU_CHOICE}" in
        0) MODE=tunnel ;;
        1) MODE=claude ;;
        2) MODE=shell ;;
    esac
}

set_label() {
    render_header
    local reply
    show_cursor
    read -e -r -p "$(printf '%sTunnel label%s (a-z, 0-9, -; max 20; empty = none): ' "$BOLD" "$RST")" reply || return
    LABEL=$(sanitize_name "$reply")
}

# --- saved configurations --------------------------------------------------
config_path() { printf '%s/%s.conf' "$VT_CONFIG_DIR" "$1"; }

# CONFIG_NAMES / CONFIG_LABELS from `vibe-tunnel configs --porcelain` (own + claude-launch).
CONFIG_NAMES=() CONFIG_LABELS=()
list_configs() {
    CONFIG_NAMES=() CONFIG_LABELS=()
    local n ws hd pr lb src
    while IFS='|' read -r n ws hd pr lb src; do
        [ -n "$n" ] || continue
        CONFIG_NAMES+=("$n")
        CONFIG_LABELS+=("$(printf '%-16s %s%s%s' "$n" "$(tilde "$ws")" "${pr:+  [$pr]}" "$([ "$src" = claude-launch ] && printf '  (claude-launch)')")")
    done < <("$VT" configs --porcelain 2>/dev/null || true)
}

load_config_file() {
    local f=$1
    config_is_valid "$f" || return 1
    local saved_home=$CLAUDE_MOBILE_HOME
    RW_BINDS=(); RO_BINDS=(); PROFILE=; LABEL=
    TIME= CPUS= MEM= GPUS= PARTITION= ACCOUNT=
    # shellcheck disable=SC1090
    . "$f"
    R_TIME=$TIME R_CPUS=$CPUS R_MEM=$MEM R_GPUS=$GPUS R_PARTITION=$PARTITION R_ACCOUNT=$ACCOUNT
    case "$MODE" in tunnel|claude|shell) ;; *) MODE=tunnel ;; esac
    [ -n "$CLAUDE_MOBILE_HOME" ] || CLAUDE_MOBILE_HOME=$saved_home
    return 0
}

save_config_file() { write_config_file "$(config_path "$1")" "$1"; }

prompt_config_name() {
    local reply
    show_cursor
    read -e -r -p "$(printf '%sConfig name%s (letters, digits, . _ - ; empty to cancel): ' "$BOLD" "$RST")" reply || return 1
    [ -n "$reply" ] || return 1
    if ! [[ "$reply" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        printf '%s  ! Invalid name: %s%s\n' "$RED" "$reply" "$RST" >&2
        sleep 1
        return 1
    fi
    printf '%s\n' "$reply"
}

save_config() {
    render_header
    local name
    name=$(prompt_config_name) || return
    if [ -e "$(config_path "$name")" ]; then
        MENU_DEFAULT=1
        menu_select "Config '$name' already exists — overwrite it?" \
            "Overwrite '$name'" \
            "Cancel (keep the existing config)"
        [ "${MENU_CHOICE}" -eq 0 ] || return
    fi
    save_config_file "$name"
    render_header
    printf '  %s✓ Saved config %s%s%s%s\n' "$GREEN" "$BOLD" "$name" "$RST" "$EL"
    printf '  %s%s%s%s\n' "$DIM" "$(config_path "$name")" "$RST" "$EL"
    printf '  %sLater: vibe-tunnel submit --config %s   or pick it under "Reuse a saved config".%s%s\n' "$DIM" "$name" "$RST" "$EL"
    clr_down
    pause
}

# Load a config by menu; returns 1 on cancel / nothing to pick. Used by the
# start screen (silent) and by the setup screen (with confirmation).
pick_config() {
    list_configs
    [ ${#CONFIG_NAMES[@]} -gt 0 ] || return 1
    local labels=("${CONFIG_LABELS[@]}" "${1:-Cancel}")
    menu_select "${2:-Pick a config to load:}" "${labels[@]}"
    [ "${MENU_CHOICE}" -ge 0 ] 2>/dev/null || return 1
    [ "${MENU_CHOICE}" -lt "${#CONFIG_NAMES[@]}" ] || return 1
    local name=${CONFIG_NAMES[$MENU_CHOICE]} f
    f=$(find_config "$name") || return 1
    if ! load_config_file "$f"; then
        render_header
        printf '%s  ! %s has unexpected content and was not loaded.%s%s\n' "$RED" "$f" "$RST" "$EL"
        clr_down; pause; return 1
    fi
    LOADED_CONFIG=$name
    # A config without a label gets a stable tunnel name from its own name.
    [ -n "$LABEL" ] || LABEL=$(sanitize_name "$name")
    return 0
}

reuse_config() {
    list_configs
    if [ ${#CONFIG_NAMES[@]} -eq 0 ]; then
        render_header
        printf '  %sNo saved configs yet — use "Save current config" first.%s%s\n' "$DIM" "$RST" "$EL"
        printf '  %sConfig dir: %s%s%s\n' "$DIM" "$VT_CONFIG_DIR" "$RST" "$EL"
        clr_down; pause; return
    fi
    local labels=("${CONFIG_LABELS[@]}" "Cancel")
    menu_select "Pick a config to load:" "${labels[@]}"
    [ "${MENU_CHOICE}" -ge 0 ] 2>/dev/null || return
    [ "${MENU_CHOICE}" -lt "${#CONFIG_NAMES[@]}" ] || return
    local name=${CONFIG_NAMES[$MENU_CHOICE]} f
    f=$(find_config "$name") || return
    if ! load_config_file "$f"; then
        render_header
        printf '%s  ! %s has unexpected content and was not loaded.%s%s\n' "$RED" "$f" "$RST" "$EL"
        clr_down; pause; return
    fi
    render_header
    printf '  %s✓ Loaded config %s%s%s — adjust anything, then Launch%s\n' "$GREEN" "$BOLD" "$name" "$RST" "$EL"
    clr_down
    pause
}

# --- reopen a running tunnel -------------------------------------------------------
reopen_running() {
    load_running
    [ ${#RUN_IDS[@]} -gt 0 ] || { render_header; echo "  (no running tunnels)"; clr_down; pause; return; }
    local labels=("${RUN_LABELS[@]}" "Cancel")
    menu_select "Reconnect to:" "${labels[@]}"
    [ "${MENU_CHOICE}" -ge 0 ] 2>/dev/null || return
    [ "${MENU_CHOICE}" -lt "${#RUN_IDS[@]}" ] || return
    local id=${RUN_IDS[$MENU_CHOICE]} tunnel=${RUN_TUNNELS[$MENU_CHOICE]}
    mkdir -p "$VT_STATE_DIR"
    printf '%s reopen %s %s\n' "$id" "$tunnel" "$(date +%s)-$$" > "$VT_STATE_DIR/last-job"
    cls; show_cursor; trap - EXIT
    [ "$NO_WAIT" -eq 1 ] && exit 0
    # `wait` returns at once for a tunnel that is already up and prints how to connect.
    exec "$VT" wait "$id"
}

# --- launch --------------------------------------------------------------------
launch() {
    if [ "$MODE" != tunnel ]; then
        local args=()
        while IFS= read -r a; do args+=("$a"); done < <(build_submit_args)
        cls; show_cursor; trap - EXIT
        exec "$VT" "$MODE" "${args[@]}"
    fi
    if [ -z "$PROFILE" ]; then
        change_profile
        [ -n "$PROFILE" ] || return
    fi
    local args=() out rc=0
    while IFS= read -r a; do args+=("$a"); done < <(build_submit_args)
    render_header
    printf '  %sSubmitting…%s%s\n' "$GREEN" "$RST" "$EL"
    clr_down
    show_cursor
    out=$("$VT" submit "${args[@]}" 2>&1) || rc=$?
    if [ "$rc" -ne 0 ]; then
        render_header
        printf '  %s! Submission failed:%s%s\n' "$RED" "$RST" "$EL"
        printf '%s\n' "$out" | sed "s/^/    /"
        clr_down; pause; return
    fi
    cls
    printf '%s\n\n' "$out"
    local job_id
    job_id=$(awk '{print $1}' "$VT_STATE_DIR/last-job" 2>/dev/null || true)
    if [ "$NO_WAIT" -eq 1 ] || [ -z "$job_id" ]; then
        exit 0
    fi
    printf '  %sWaiting for the tunnel (Ctrl-C stops waiting; the job keeps running)…%s\n\n' "$DIM" "$RST"
    trap - EXIT
    exec "$VT" wait "$job_id"
}

# --- main ----------------------------------------------------------------------
[ -x "$VT" ] || { echo "vibe-tunnel not found at $VT" >&2; exit 1; }
load_profiles
# Sensible defaults: first profile, and a preloaded config if asked for.
[ ${#PROFILE_NAMES[@]} -gt 0 ] && PROFILE=${PROFILE_NAMES[0]}
if [ -n "$PRELOAD" ]; then
    f=$(find_config "$PRELOAD") || { echo "config not found: $PRELOAD" >&2; exit 1; }
    load_config_file "$f" || { echo "config has unexpected content: $f" >&2; exit 1; }
fi

# --- screens ---------------------------------------------------------------------
LOADED_CONFIG=

screen_sandbox() {
    HEADER_MODE=setup
    while true; do
        menu_select "Sandbox — what the container can see:" \
            "Change workspace directory        $(tilde "$WORKSPACE")" \
            "Change home directory             $(tilde "$CLAUDE_MOBILE_HOME")" \
            "Add read-write directory" \
            "Add read-only directory" \
            "Remove an extra directory" \
            "Back"
        case "${MENU_CHOICE}" in
            0) if ws=$(prompt_dir "Workspace directory"); then WORKSPACE=$ws; fi ;;
            1) if hd=$(prompt_dir "Home directory" allow-missing); then CLAUDE_MOBILE_HOME=$hd; fi ;;
            2) if src=$(prompt_dir "Read-write directory"); then RW_BINDS+=("$(prompt_dest "$src")"); fi ;;
            3) if src=$(prompt_dir "Read-only directory"); then RO_BINDS+=("$(prompt_dest "$src")"); fi ;;
            4) remove_bind ;;
            *) return ;;
        esac
    done
}

# The setup screen: everything about the run to start, grouped into submenus.
screen_setup() {
    HEADER_MODE=setup
    local items actions
    while true; do
        items=() actions=()
        items+=("Sandbox        workspace, home, extra directories ▸");                             actions+=(sandbox)
        if [ "$MODE" = tunnel ]; then
            items+=("Resources      $(profile_summary "$PROFILE") ▸");                              actions+=(resources)
            items+=("Tunnel label   ${LABEL:-(none: vibe-<jobid>)}");                              actions+=(label)
        fi
        items+=("Load a saved config${LOADED_CONFIG:+   (current: $LOADED_CONFIG)}");            actions+=(load)
        items+=("Save as config");                                                                  actions+=(save)
        items+=("Review the command");                                                              actions+=(review)
        case "$MODE" in
            tunnel) items+=("Launch ▶   submit the job and wait for the tunnel") ;;
            claude) items+=("Launch ▶   start Claude Code in the container here") ;;
            shell)  items+=("Launch ▶   open a shell in the container here") ;;
        esac
        actions+=(launch)
        items+=("Back");                                                                            actions+=(back)
        menu_select "New $MODE — set it up, then Launch:" "${items[@]}"
        if [ "${MENU_CHOICE}" -ge 0 ] 2>/dev/null && [ "${MENU_CHOICE}" -lt ${#actions[@]} ]; then action=${actions[$MENU_CHOICE]}; else action=back; fi
        case "$action" in
            sandbox)   screen_sandbox ;;
            resources) change_resources ;;
            label)     set_label ;;
            load)      pick_config || true ;;
            save)      save_config ;;
            review)    review_command ;;
            launch)    launch ;;
            back)      return ;;
        esac
    done
}

# Start a new run: choose the starting point (saved config or scratch), then set it up.
screen_start() {
    MODE=$1
    HEADER_MODE=home
    list_configs
    if [ ${#CONFIG_NAMES[@]} -gt 0 ]; then
        if ! pick_config "Start from scratch (current directory, defaults)" "Start the $MODE from:"; then
            # "from scratch" is the last entry; a real cancel (q) returns MENU_CHOICE=-2
            [ "${MENU_CHOICE}" -eq -2 ] && return
            WORKSPACE=$(pwd); CLAUDE_MOBILE_HOME=$VT_DEFAULT_HOME; RW_BINDS=(); RO_BINDS=(); LABEL=; LOADED_CONFIG=
            R_TIME= R_CPUS= R_MEM= R_GPUS= R_PARTITION= R_ACCOUNT=
            [ ${#PROFILE_NAMES[@]} -gt 0 ] && PROFILE=${PROFILE_NAMES[0]}
        fi
    fi
    # A config saved from another mode still supplies the sandbox; the verb chosen here wins.
    MODE=$1
    screen_setup
}

screen_home() {
    local items actions
    while true; do
        HEADER_MODE=home
        load_running
        items=() actions=()
        if [ ${#RUN_IDS[@]} -gt 0 ]; then items+=("Reconnect to a running tunnel ▶"); actions+=(reopen); fi
        items+=("New VS Code tunnel              slurm job, VS Code attaches into the container");   actions+=(tunnel)
        items+=("Claude Code in this terminal    same sandbox, no VS Code");                         actions+=(claude)
        items+=("Shell in the container");                                                           actions+=(shell)
        items+=("Quit");                                                                             actions+=(quit)
        menu_select "What do you want to do?" "${items[@]}"
        if [ "${MENU_CHOICE}" -eq -2 ]; then action=quit
        elif [ "${MENU_CHOICE}" -ge 0 ] 2>/dev/null && [ "${MENU_CHOICE}" -lt ${#actions[@]} ]; then action=${actions[$MENU_CHOICE]}
        else action=none; fi
        case "$action" in
            reopen) reopen_running ;;
            tunnel|claude|shell) screen_start "$action" ;;
            quit)   cls; printf '%s  Bye.%s\n' "$DIM" "$RST"; exit 0 ;;
            *) : ;;
        esac
    done
}

cls
if [ -n "$PRELOAD" ]; then
    # A preloaded config goes straight to its setup screen.
    LOADED_CONFIG=$PRELOAD
    screen_setup
fi
screen_home
