#!/usr/bin/env bash
set -euo pipefail

# vibe-tunnel ---------------------------------------------------------------
# Cluster-side CLI. Submits a slurm job that starts euler-vibe's sandboxed
# Claude container on a compute node and runs a VS Code tunnel *inside* it,
# so VS Code (desktop or vscode.dev) attaches straight into the sandbox.
#
#   vibe-tunnel launch [--no-wait]        interactive menu: sandbox, resources, label -> submit
#   vibe-tunnel submit [PROFILE] [--name LABEL] [--config NAME]
#                              [--workspace DIR] [--home DIR]
#                              [--rw DIR[:DEST]]... [--ro DIR[:DEST]]...
#                              [--time T] [--cpus N] [--mem M] [--gpus G] [--partition P] [--account A]
#                              [--extensions ID,ID] [--json]
#   vibe-tunnel claude [sandbox opts] [--srun [PROFILE]] [-- CLAUDE_ARGS]   Claude Code in the container
#   vibe-tunnel shell  [sandbox opts] [--srun [PROFILE]]                    a shell in the container
#                                       (right here, or with --srun inside an interactive slurm job)
#   vibe-tunnel wait JOBID                block until the tunnel link appears, print it
#   vibe-tunnel status [--porcelain]      running tunnels + their links
#   vibe-tunnel show JOBID                state, node and the full log (machine-readable)
#   vibe-tunnel logs JOBID [-f]           tail the job log
#   vibe-tunnel stop JOBID|LABEL          scancel
#   vibe-tunnel configs [--porcelain]     saved sandbox configs (own + claude-launch's)
#   vibe-tunnel config show NAME [--porcelain] | save NAME [--profile P] [--mode M] [sandbox opts]
#                                       | delete NAME        (used by the VS Code extension)
#   vibe-tunnel ls [DIR] [--porcelain]    subdirectories of DIR (remote directory browser)
#   vibe-tunnel profiles [--porcelain]    available sbatch resource profiles (presets)
#   vibe-tunnel profiles show|edit NAME   print / edit a profile (edit copies a repo one to ~/.vibe-tunnel/profiles)
#   vibe-tunnel profiles new NAME [--from BASE]   create your own profile from a preset and edit it
#   vibe-tunnel doctor                    check image, CLI, proxy, dirs
#
# Saved configs: ~/.vibe-tunnel/configs/NAME.conf, the same format as claude-launch
# (WORKSPACE, MODE, CLAUDE_MOBILE_HOME, RW_BINDS, RO_BINDS) plus PROFILE, LABEL and
# resource overrides. Older locations (~/.config/vibe-tunnel, claude-launch) are read too.
# The laptop client only calls these subcommands over ssh.

VT_BIN=$(realpath "$0")
VIBE_TUNNEL_DIR=$(dirname "$(dirname "$VT_BIN")")
export VIBE_TUNNEL_DIR

# Laptop client mode: no slurm here, so drive the cluster copy over ssh instead
# (bin/vibe-tunnel-client). VT_ON_CLUSTER=1 forces cluster mode.
if [ -z "${VT_ON_CLUSTER:-}" ] && ! command -v sbatch >/dev/null 2>&1; then
    exec "$VIBE_TUNNEL_DIR/bin/vibe-tunnel-client" "$@"
fi

# shellcheck disable=SC1091
. "$VIBE_TUNNEL_DIR/bin/vibe-tunnel-lib"
JOB_PREFIX=vibe-tunnel

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'; DIM=$'\033[2m'; RST=$'\033[0m'
    GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; CYAN=$'\033[36m'
else
    BOLD= DIM= RST= GREEN= YELLOW= RED= CYAN=
fi
ok()   { printf '  %s✓%s %s\n' "$GREEN" "$RST" "$*"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$RST" "$*"; }
die()  { printf '%svibe-tunnel: %s%s\n' "$RED" "$*" "$RST" >&2; exit 1; }

usage() { sed -n '4,35p' "$VT_BIN" | sed 's/^# \{0,1\}//'; }

# --- helpers ---------------------------------------------------------------

# Absolute path that need not exist yet (GNU realpath -m, with a portable fallback).
abspath() {
    realpath -m -- "$1" 2>/dev/null && return
    case "$1" in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$(pwd)" "$1" ;; esac
}

resolve_profile() {
    local p=$1
    if [ -f "$p" ]; then realpath "$p"; return; fi
    for d in "$VT_USER_PROFILES" "$VIBE_TUNNEL_DIR/profiles"; do
        [ -f "$d/$p.sbatch" ] && { printf '%s' "$d/$p.sbatch"; return; }
        [ -f "$d/$p" ] && { printf '%s' "$d/$p"; return; }
    done
    return 1
}

# One-line summary of a profile's resources for menus.
profile_summary() {
    awk '
        /^#SBATCH/ {
            for (i = 2; i <= NF; i++) {
                if ($i ~ /^--(time|cpus-per-task|mem|mem-per-cpu|gpus|gres|partition)=/) {
                    sub(/^--/, "", $i); printf "%s ", $i
                }
            }
        }
    ' "$1" | sed 's/ $//'
}

# All of the user's vibe-tunnel jobs: id|name|state|node|elapsed|timeleft
squeue_jobs() {
    { squeue -u "$USER" -h -o '%i|%j|%T|%N|%M|%L' 2>/dev/null | awk -F'|' -v p="$JOB_PREFIX" 'index($2, p) == 1'; } || true
}

# Extract what the launcher needs from a job log. Always succeed: a missing log
# or no match yet (job still pending) is normal and must not trip set -e/pipefail.
# CLI <= 1.12x: "Open this link in your browser URL"; CLI >= 1.13x: "  ➜  Open:  URL"
log_link()   { { grep -Eo '(Open this link in your browser|Open:)[[:space:]]+https?://[^[:space:]]+' "$1" 2>/dev/null | tail -n1 | awk '{print $NF}'; } || true; }
log_tunnel() { { grep -Eo '^VT_TUNNEL_NAME=.*' "$1" 2>/dev/null | tail -n1 | cut -d= -f2; } || true; }
log_workspace() { { grep -Eo '^VT_WORKSPACE=.*' "$1" 2>/dev/null | tail -n1 | cut -d= -f2-; } || true; }
log_device() { { grep -Eo 'log into[[:space:]]+https?://[^[:space:]]+[[:space:]]+and use code[[:space:]]+[A-Za-z0-9-]+' "$1" 2>/dev/null | tail -n1 | awk '{print $3 " " $NF}'; } || true; }

# --- sandbox options (shared by submit / claude / shell) --------------------
OPT_PROFILE= OPT_LABEL= OPT_CONFIG= OPT_WORKSPACE= OPT_HOME= OPT_JSON=0 OPT_CF=
OPT_EXTENSIONS=${VT_EXTENSIONS-anthropic.claude-code}
OPT_RW=() OPT_RO=() OPT_REST=()
R_TIME= R_CPUS= R_MEM= R_GPUS= R_PARTITION= R_ACCOUNT=
parse_sandbox_opts() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --time)       R_TIME=$2; shift ;;
            --cpus)       R_CPUS=$2; shift ;;
            --mem)        R_MEM=$2; shift ;;
            --gpus)       R_GPUS=$2; shift ;;
            --partition)  R_PARTITION=$2; shift ;;
            --account)    R_ACCOUNT=$2; shift ;;
            --name)       OPT_LABEL=$2; shift ;;
            --config)     OPT_CONFIG=$2; shift ;;
            --workspace)  OPT_WORKSPACE=$2; shift ;;
            --home)       OPT_HOME=$2; shift ;;
            --rw)         OPT_RW+=("$2"); shift ;;
            --ro)         OPT_RO+=("$2"); shift ;;
            --extensions) OPT_EXTENSIONS=$2; shift ;;
            --json)       OPT_JSON=1 ;;
            --)           shift; OPT_REST=("$@"); break ;;
            -h|--help)    usage; exit 0 ;;
            -*)           die "unknown option: $1" ;;
            *)            [ -z "$OPT_PROFILE" ] || die "unexpected argument: $1"; OPT_PROFILE=$1 ;;
        esac
        shift
    done
    if [ -n "$OPT_CONFIG" ]; then
        OPT_CF=$(find_config "$OPT_CONFIG") || die "config not found: $OPT_CONFIG (see: vibe-tunnel configs)"
        config_is_valid "$OPT_CF" || die "config has unexpected content, refusing to use it: $OPT_CF"
    fi
    if [ -n "$OPT_WORKSPACE" ]; then
        [ -d "$OPT_WORKSPACE" ] || die "workspace is not a directory: $OPT_WORKSPACE"
        OPT_WORKSPACE=$(realpath -- "$OPT_WORKSPACE")
    fi
    [ -z "$OPT_HOME" ] || OPT_HOME=$(abspath "$OPT_HOME")
    [ -e "$VT_IMAGE" ] || die "container image missing: $VT_IMAGE (run ./setup.sh to build it)"
}

# Per-run settings file for bin/vibe-tunnel-job. Prints its path.
write_env_file() {
    local tunnel_name=$1 stamp f b
    mkdir -p "$VT_LOG_DIR" "$VT_JOB_DIR" "$VT_USER_PROFILES"
    stamp=$(date +%Y%m%d-%H%M%S)-$$
    f=$VT_JOB_DIR/$stamp.env
    {
        printf '# vibe-tunnel run settings, written %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        printf 'VT_TUNNEL_NAME=%q\n' "$tunnel_name"
        printf 'VT_CONFIG=%q\n' "$OPT_CONFIG"
        printf 'VT_CONFIG_FILE=%q\n' "$OPT_CF"
        printf 'VT_WORKSPACE=%q\n' "$OPT_WORKSPACE"
        printf 'VT_HOME=%q\n' "$OPT_HOME"
        printf 'VT_EXTENSIONS=%q\n' "$OPT_EXTENSIONS"
        printf 'VT_RW_BINDS=('; for b in "${OPT_RW[@]+"${OPT_RW[@]}"}"; do printf ' %q' "$b"; done; printf ' )\n'
        printf 'VT_RO_BINDS=('; for b in "${OPT_RO[@]+"${OPT_RO[@]}"}"; do printf ' %q' "$b"; done; printf ' )\n'
    } > "$f"
    printf '%s' "$f"
}

# --- submit -----------------------------------------------------------------
cmd_submit() {
    parse_sandbox_opts "$@"
    local profile=$OPT_PROFILE label=$OPT_LABEL
    local k v
    if [ -n "$OPT_CF" ]; then
        # A saved config may carry its profile, resource overrides and label; explicit flags win.
        [ -n "$profile" ] || profile=$(config_field "$OPT_CF" PROFILE)
        [ -n "$label" ]   || label=$(config_field "$OPT_CF" LABEL)
        [ -n "$label" ]   || label=$OPT_CONFIG      # a stable tunnel name per config
        for k in "${RESOURCE_KEYS[@]}"; do
            eval "v=\${R_$k:-}"
            [ -n "$v" ] || eval "R_$k=\$(config_field \"\$OPT_CF\" $k)"
        done
    fi
    [ -n "$profile" ] || die "submit needs a PROFILE (see: vibe-tunnel profiles)"
    local profile_path
    profile_path=$(resolve_profile "$profile") || die "profile not found: $profile"
    # Resource overrides go to sbatch as flags, which beat the profile's #SBATCH lines.
    local sbatch_res=()
    for k in "${RESOURCE_KEYS[@]}"; do
        eval "v=\${R_$k:-}"
        [ -z "$v" ] || sbatch_res+=("$(resource_flag "$k")=$v")
    done
    [ -x "$VT_CODE_CLI" ] || die "VS Code CLI missing: $VT_CODE_CLI (run ./setup.sh)"

    local tunnel_name= job_name=$JOB_PREFIX
    if [ -n "$label" ]; then
        tunnel_name=$(sanitize_name "$label")
        [ -n "$tunnel_name" ] || die "label '$label' has no usable characters (a-z, 0-9, -)"
        job_name="$JOB_PREFIX-$tunnel_name"
        # Refuse a second tunnel with the same name: VS Code would reject the
        # duplicate registration and the launcher could not tell them apart.
        if squeue_jobs | awk -F'|' -v n="$job_name" '$2 == n {found=1} END {exit !found}'; then
            die "a tunnel job named '$job_name' is already queued/running (vibe-tunnel status)"
        fi
    fi

    local env_file out job_id
    env_file=$(write_env_file "$tunnel_name")
    # --export must keep ALL, otherwise sbatch stops exporting the rest of the
    # submission environment (modules, proxy, ...). Values contain no commas.
    out=$(sbatch --parsable \
        --job-name="$job_name" \
        --output="$VT_LOG_DIR/%j.log" \
        --export="ALL,VIBE_TUNNEL_DIR=$VIBE_TUNNEL_DIR,VT_ENV_FILE=$env_file,VT_STATE_DIR=$VT_STATE_DIR,VT_MODE=tunnel" \
        "${sbatch_res[@]+"${sbatch_res[@]}"}" \
        "$profile_path") || die "sbatch failed"
    job_id=${out%%;*}
    [ -n "$job_id" ] || die "could not read the job id from sbatch output: $out"
    printf '%s %s %s %s\n' "$job_id" "$job_name" "$tunnel_name" "$(date +%s)-$$" > "$VT_STATE_DIR/last-job"

    if [ "$OPT_JSON" -eq 1 ]; then
        printf '{"job_id":"%s","job_name":"%s","tunnel_name":"%s","log":"%s","profile":"%s","config":"%s","resources":"%s"}\n' \
            "$job_id" "$job_name" "$tunnel_name" "$VT_LOG_DIR/$job_id.log" "$profile_path" "$OPT_CONFIG" "$(resources_summary "$profile_path")"
    else
        printf 'Submitted job %s%s%s (%s)\n' "$BOLD" "$job_id" "$RST" "$job_name"
        printf '  profile : %s\n' "$profile_path"
        printf '  resources: %s\n' "$(resources_summary "$profile_path")"
        [ -z "$OPT_CONFIG" ]    || printf '  config  : %s\n' "$OPT_CONFIG"
        [ -z "$OPT_WORKSPACE" ] || printf '  workspace: %s\n' "$OPT_WORKSPACE"
        printf '  log     : %s\n' "$VT_LOG_DIR/$job_id.log"
        printf '\nFollow it with:  %svibe-tunnel logs %s -f%s\n' "$CYAN" "$job_id" "$RST"
    fi
}

# --- claude / shell: run the container interactively, here ------------------
cmd_run() {
    local mode=$1; shift
    # --srun [PROFILE]: run inside an interactive slurm job with the profile's resources
    # (from the flag, the config, or the first preset) instead of on this node.
    local use_srun=0 pass=() a
    while [ $# -gt 0 ]; do
        case "$1" in
            --srun) use_srun=1; if [ -n "${2:-}" ] && [ "${2#-}" = "$2" ] && resolve_profile "$2" >/dev/null 2>&1; then pass+=("$2"); shift; fi ;;
            *) pass+=("$1") ;;
        esac; shift
    done
    parse_sandbox_opts "${pass[@]+"${pass[@]}"}"
    if [ "$use_srun" -eq 1 ] && [ -z "${SLURM_JOB_ID:-}" ]; then
        local profile=$OPT_PROFILE k v pp
        [ -n "$profile" ] || [ -z "$OPT_CF" ] || profile=$(config_field "$OPT_CF" PROFILE)
        [ -n "$profile" ] || profile=$(cmd_profiles --porcelain | head -n1 | cut -d'|' -f1)
        pp=$(resolve_profile "$profile") || die "profile not found: $profile"
        if [ -n "$OPT_CF" ]; then for k in "${RESOURCE_KEYS[@]}"; do eval "v=\${R_$k:-}"; [ -n "$v" ] || eval "R_$k=\$(config_field \"\$OPT_CF\" $k)"; done; fi
        local flags=() line
        while IFS= read -r line; do k=${line%%=*}; eval "v=\${R_$k:-}"; [ -n "$v" ] || flags+=("$(resource_flag "$k")=${line#*=}"); done < <(profile_defaults "$pp")
        for k in "${RESOURCE_KEYS[@]}"; do eval "v=\${R_$k:-}"; [ -z "$v" ] || flags+=("$(resource_flag "$k")=$v"); done
        command -v srun >/dev/null 2>&1 || die "srun not found"
        printf '%sstarting an interactive job (%s) for vibe-tunnel %s…%s\n' "$DIM" "$(resources_summary "$pp")" "$mode" "$RST" >&2
        # drop --srun (and its profile) from the args the inner invocation sees
        exec srun --job-name="vibe-tunnel-$mode" "${flags[@]+"${flags[@]}"}" --pty "$VT_BIN" "$mode" "${pass[@]+"${pass[@]}"}"
    fi
    local env_file
    env_file=$(write_env_file "")
    [ -n "${SLURM_JOB_ID:-}" ] || warn "not inside a slurm job: this runs on $(hostname -s). Add --srun [PROFILE] to run it in an interactive job."
    VT_ENV_FILE=$env_file VT_MODE=$mode exec "$VIBE_TUNNEL_DIR/bin/vibe-tunnel-job" "${OPT_REST[@]+"${OPT_REST[@]}"}"
}

# --- status / show / logs / stop -------------------------------------------
cmd_status() {
    local porcelain=0
    [ "${1:-}" = "--porcelain" ] && porcelain=1
    local rows
    rows=$(squeue_jobs || true)
    if [ -z "$rows" ]; then
        [ "$porcelain" -eq 1 ] || echo "No vibe-tunnel jobs queued or running."
        return 0
    fi
    [ "$porcelain" -eq 1 ] || printf '%s%-10s %-28s %-9s %-10s %-9s %-9s %s%s\n' "$BOLD" JOBID NAME STATE NODE ELAPSED LEFT TUNNEL "$RST"
    local id name state node elapsed left log tunnel link ws
    while IFS='|' read -r id name state node elapsed left; do
        log=$VT_LOG_DIR/$id.log
        tunnel=$(log_tunnel "$log"); link=$(log_link "$log"); ws=$(log_workspace "$log")
        if [ "$porcelain" -eq 1 ]; then
            printf '%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$id" "$name" "$state" "$node" "$elapsed" "$left" "$tunnel" "$link" "$ws"
        else
            printf '%-10s %-28s %-9s %-10s %-9s %-9s %s\n' "$id" "$name" "$state" "${node:--}" "$elapsed" "$left" "${tunnel:--}"
            [ -z "$link" ] || printf '           %s%s%s\n' "$DIM" "$link" "$RST"
        fi
    done <<< "$rows"
}

cmd_show() {
    local id=${1:-}; [ -n "$id" ] || die "show needs a JOBID"
    local row
    row=$(squeue_jobs | awk -F'|' -v id="$id" '$1 == id')
    if [ -n "$row" ]; then
        IFS='|' read -r _ name state node elapsed left <<< "$row"
        printf 'STATE=%s\nNODE=%s\nNAME=%s\nELAPSED=%s\nLEFT=%s\n' "$state" "$node" "$name" "$elapsed" "$left"
    else
        # Not in squeue any more: ask the accounting db so the launcher can tell
        # "finished" from "never existed".
        state=$(sacct -j "$id" -n -X -o State 2>/dev/null | head -n1 | tr -d ' ' || true)
        printf 'STATE=%s\nNODE=\nNAME=\nELAPSED=\nLEFT=\n' "${state:-UNKNOWN}"
    fi
    printf 'LOG=%s\n---LOG---\n' "$VT_LOG_DIR/$id.log"
    [ -f "$VT_LOG_DIR/$id.log" ] && cat "$VT_LOG_DIR/$id.log" || true
}

cmd_logs() {
    local id=${1:-}; [ -n "$id" ] || die "logs needs a JOBID"
    local log=$VT_LOG_DIR/$id.log
    if [ "${2:-}" = "-f" ]; then
        touch "$log"; exec tail -n 60 -F "$log"
    fi
    [ -f "$log" ] || die "no log yet at $log"
    tail -n 80 "$log"
}

cmd_stop() {
    local target=${1:-}; [ -n "$target" ] || die "stop needs a JOBID or LABEL"
    local ids
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        ids=$target
    else
        local n; n=$(sanitize_name "$target")
        ids=$(squeue_jobs | awk -F'|' -v n="$JOB_PREFIX-$n" '$2 == n {print $1}')
        [ -n "$ids" ] || die "no running tunnel job named $JOB_PREFIX-$n"
    fi
    # shellcheck disable=SC2086
    scancel $ids && echo "cancelled: $ids"
}

# --- wait -------------------------------------------------------------------
# Block until the job's tunnel is reachable. Prints the one-time device-code
# login when it shows up, then TUNNEL=/LINK=/DESKTOP= lines for scripts.
cmd_wait() {
    local id=${1:-}; [ -n "$id" ] || die "wait needs a JOBID"
    local poll=${VT_POLL_SECONDS:-5} log=$VT_LOG_DIR/$id.log
    local row state node last_state= seen_codes=" " dev url code link tunnel
    while :; do
        row=$(squeue_jobs | awk -F'|' -v id="$id" '$1 == id')
        if [ -n "$row" ]; then
            IFS='|' read -r _ _ state node _ _ <<< "$row"
        else
            state=$(sacct -j "$id" -n -X -o State 2>/dev/null | head -n1 | tr -d ' ' || true)
            state=${state:-UNKNOWN}
        fi
        if [ "$state" != "$last_state" ]; then
            printf '  %s[%s]%s job %s: %s%s\n' "$DIM" "$(date '+%H:%M:%S')" "$RST" "$id" "$state" "${node:+ on $node}"
            last_state=$state
        fi
        link=$(log_link "$log"); tunnel=$(log_tunnel "$log")
        # A device code is only current while the tunnel is not up yet; once the
        # link is in the log the code has been used (or will never be needed).
        dev=; [ -n "$link" ] || dev=$(log_device "$log")
        if [ -n "$dev" ]; then
            url=${dev% *}; code=${dev##* }
            case "$seen_codes" in *" $code "*) ;; *)
                seen_codes="$seen_codes$code "
                printf '\n  %sVS Code tunnel login needed%s (once per sandbox home):\n' "$BOLD" "$RST"
                printf '    open  %s%s%s\n    code  %s%s%s\n\n' "$CYAN" "$url" "$RST" "$BOLD" "$code" "$RST"
                printf 'DEVICE_URL=%s\nDEVICE_CODE=%s\n' "$url" "$code" ;;
            esac
        fi
        if [ -n "$link" ] && [ -n "$tunnel" ]; then
            local ws; ws=$(log_workspace "$log"); ws=${ws:-/workspace}
            printf '\n  %sTunnel is up.%s\n' "$GREEN" "$RST"
            printf 'TUNNEL=%s\nWORKSPACE=%s\nLINK=%s\nDESKTOP=code --folder-uri %q\n' "$tunnel" "$ws" "$link" "vscode-remote://tunnel+$tunnel$ws"
            return 0
        fi
        case "$state" in
            PENDING|CONFIGURING|RUNNING|COMPLETING|REQUEUED|SUSPENDED) ;;
            *)
                printf '\n  %sjob %s ended (%s) before the tunnel came up.%s Last log lines:\n' "$RED" "$id" "$state" "$RST"
                [ -f "$log" ] && tail -n 20 "$log" | sed 's/^/    /'
                return 1 ;;
        esac
        sleep "$poll"
    done
}

cmd_launch() { exec "$VIBE_TUNNEL_DIR/bin/vibe-tunnel-launch" "$@"; }

# --- configs / profiles -----------------------------------------------------
cmd_configs() {
    local porcelain=0; [ "${1:-}" = "--porcelain" ] && porcelain=1
    local d f name ws hd pr lb src pp found=0 seen=" "
    for d in "$VT_CONFIG_DIR" "$VT_OLD_CONFIG_DIR" "$CLAUDE_LAUNCH_CONFIG_DIR"; do
        [ -d "$d" ] || continue
        case "$d" in "$VT_CONFIG_DIR") src=vibe-tunnel ;; "$VT_OLD_CONFIG_DIR") src=old-location ;; *) src=claude-launch ;; esac
        for f in "$d"/*.conf; do
            [ -e "$f" ] || continue
            name=${f##*/}; name=${name%.conf}
            case "$seen" in *" $name "*) continue ;; esac
            seen="$seen$name "
            found=1
            if ! config_is_valid "$f"; then
                [ "$porcelain" -eq 1 ] || warn "$name: unexpected content, skipped"
                continue
            fi
            ws=$(config_field "$f" WORKSPACE); hd=$(config_field "$f" CLAUDE_MOBILE_HOME)
            pr=$(config_field "$f" PROFILE);   lb=$(config_field "$f" LABEL)
            if [ "$porcelain" -eq 1 ]; then printf '%s|%s|%s|%s|%s|%s\n' "$name" "$ws" "$hd" "$pr" "$lb" "$src"
            else
                printf '  %s%-20s%s %s\n' "$BOLD" "$name" "$RST" "$ws"
                printf '  %-20s %shome %s%s%s%s\n' "" "$DIM" "$hd" "${pr:+  profile $pr}" "${lb:+  label $lb}" "$RST"
                if [ -n "$pr" ] && pp=$(resolve_profile "$pr"); then
                    local k; for k in "${RESOURCE_KEYS[@]}"; do eval "R_$k=\$(config_field \"\$f\" $k)"; done
                    printf '  %-20s %s%s%s\n' "" "$DIM" "$(resources_summary "$pp")" "$RST"
                    for k in "${RESOURCE_KEYS[@]}"; do eval "R_$k="; done
                fi
                [ "$src" = vibe-tunnel ] || printf '  %-20s %s(from %s; re-save to move it to %s)%s\n' "" "$DIM" "$src" "$VT_CONFIG_DIR" "$RST"
            fi
        done
    done
    if [ "$found" -eq 0 ] && [ "$porcelain" -eq 0 ]; then
        echo "No saved configs in $VT_CONFIG_DIR."
        echo "Create one with 'vibe-tunnel launch' -> 'Save current config', or pass --workspace/--rw/--ro directly."
    fi
}

cmd_profiles() {
    case "${1:-}" in
        show|edit|new) local sub=$1; shift; "profiles_$sub" "$@"; return ;;
    esac
    local porcelain=0; [ "${1:-}" = "--porcelain" ] && porcelain=1
    local d f name seen=" "
    # User profiles (~/.vibe-tunnel/profiles) shadow repo profiles of the same name.
    for d in "$VT_USER_PROFILES" "$VIBE_TUNNEL_DIR/profiles"; do
        [ -d "$d" ] || continue
        for f in "$d"/*.sbatch; do
            [ -e "$f" ] || continue
            name=${f##*/}; name=${name%.sbatch}
            case "$seen" in *" $name "*) continue ;; esac
            seen="$seen$name "
            if [ "$porcelain" -eq 1 ]; then printf '%s|%s|%s\n' "$name" "$f" "$(profile_summary "$f")"
            else printf '  %s%-18s%s %s  %s%s%s\n' "$BOLD" "$name" "$RST" "$(profile_summary "$f")" "$DIM" "$f" "$RST"; fi
        done
    done
}

profiles_show() {
    local f; f=$(resolve_profile "${1:?profiles show needs a NAME}") || die "profile not found: $1"
    printf '%s# %s%s\n' "$DIM" "$f" "$RST"; cat "$f"
}
# Your own copy of a profile lives in ~/.vibe-tunnel/profiles and shadows the
# repo's; editing a repo profile copies it there first, so the shared presets
# stay untouched.
profiles_edit() {
    local name=${1:?profiles edit needs a NAME} f
    f=$(resolve_profile "$name") || die "profile not found: $name (vibe-tunnel profiles new $name creates one)"
    [ -t 0 ] || die "profiles edit needs a terminal (from the laptop: vibe-tunnel profiles edit $name)"
    mkdir -p "$VT_USER_PROFILES"
    case "$f" in
        "$VT_USER_PROFILES"/*) ;;
        *) cp "$f" "$VT_USER_PROFILES/$name.sbatch"; f=$VT_USER_PROFILES/$name.sbatch
           printf '  copied the preset to %s (your copy shadows the repo one)\n' "$f" ;;
    esac
    "${EDITOR:-${VISUAL:-vi}}" "$f"
    printf '  %s: %s\n' "$name" "$(profile_summary "$f")"
}
profiles_new() {
    local name=${1:?profiles new needs a NAME} base=cpu_4h f b
    shift || true
    while [ $# -gt 0 ]; do case "$1" in --from) base=$2; shift ;; *) die "profiles new: unknown option $1" ;; esac; shift; done
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid profile name: $name"
    f=$VT_USER_PROFILES/$name.sbatch
    [ ! -e "$f" ] || die "profile already exists: $f (vibe-tunnel profiles edit $name)"
    b=$(resolve_profile "$base") || die "base profile not found: $base"
    mkdir -p "$VT_USER_PROFILES"
    sed "s/resource profile \"[^\"]*\"/resource profile \"$name\"/; s/vibe-tunnel submit [A-Za-z0-9._-]* /vibe-tunnel submit $name /" "$b" > "$f"
    printf '  created %s from %s\n' "$f" "$base"
    if [ -t 0 ]; then "${EDITOR:-${VISUAL:-vi}}" "$f"; fi
    printf '  %s: %s\n' "$name" "$(profile_summary "$f")"
}

# --- config show / save / delete ------------------------------------------------
cmd_config() {
    local sub=${1:-}; shift || true
    case "$sub" in
        show)   config_show "$@" ;;
        save)   config_save "$@" ;;
        delete) config_delete "$@" ;;
        *) die "config needs show|save|delete" ;;
    esac
}
config_show() {
    local name=${1:-} porcelain=0; [ "${2:-}" = "--porcelain" ] && porcelain=1
    [ -n "$name" ] || die "config show needs a NAME"
    local f; f=$(find_config "$name") || die "config not found: $name"
    config_is_valid "$f" || die "config has unexpected content: $f"
    local src=other; case "$f" in "$VT_CONFIG_DIR"/*) src=vibe-tunnel ;; "$VT_OLD_CONFIG_DIR"/*) src=old-location ;; "$CLAUDE_LAUNCH_CONFIG_DIR"/*) src=claude-launch ;; esac
    VT_CONFIG_FILE=$f VT_WORKSPACE= VT_HOME= VT_RW_BINDS=() VT_RO_BINDS=()
    WORKSPACE= CLAUDE_MOBILE_HOME= RW_BINDS=() RO_BINDS=() MODE= PROFILE= LABEL= TIME= CPUS= MEM= GPUS= PARTITION= ACCOUNT=
    # shellcheck disable=SC1090
    . "$f"
    if [ "$porcelain" -eq 1 ]; then
        printf 'NAME=%s\nFILE=%s\nSOURCE=%s\nWORKSPACE=%s\nMODE=%s\nHOME=%s\nPROFILE=%s\nLABEL=%s\n' \
            "$name" "$f" "$src" "$WORKSPACE" "${MODE:-tunnel}" "$CLAUDE_MOBILE_HOME" "$PROFILE" "$LABEL"
        printf 'TIME=%s\nCPUS=%s\nMEM=%s\nGPUS=%s\nPARTITION=%s\nACCOUNT=%s\n' "$TIME" "$CPUS" "$MEM" "$GPUS" "$PARTITION" "$ACCOUNT"
        local b; for b in "${RW_BINDS[@]+"${RW_BINDS[@]}"}"; do printf 'RW=%s\n' "$b"; done
        for b in "${RO_BINDS[@]+"${RO_BINDS[@]}"}"; do printf 'RO=%s\n' "$b"; done
    else
        printf '%s# %s (%s)%s\n' "$DIM" "$f" "$src" "$RST"; grep -v '^#' "$f"
    fi
}
# config save NAME [--profile P] [--mode tunnel|claude|shell] [--workspace D] [--home D] [--rw ..] [--ro ..]
#                  [--name LABEL] [--time ..] [--cpus ..] [--mem ..] [--gpus ..] [--partition ..] [--account ..]
config_save() {
    local name=${1:-}; shift || true
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid config name: '$name' (letters, digits, . _ -)"
    local mode=tunnel rest=() profile=
    while [ $# -gt 0 ]; do
        case "$1" in
            --profile) profile=$2; shift ;;
            --mode)    mode=$2; shift ;;
            *)         rest+=("$1") ;;
        esac; shift
    done
    case "$mode" in tunnel|claude|shell) ;; *) die "mode must be tunnel, claude or shell" ;; esac
    parse_sandbox_opts "${rest[@]+"${rest[@]}"}"
    [ -z "$OPT_PROFILE" ] || profile=$OPT_PROFILE
    [ -z "$profile" ] || resolve_profile "$profile" >/dev/null || die "profile not found: $profile"
    WORKSPACE=${OPT_WORKSPACE:-$(pwd)}
    CLAUDE_MOBILE_HOME=${OPT_HOME:-$VT_DEFAULT_HOME}
    RW_BINDS=("${OPT_RW[@]+"${OPT_RW[@]}"}"); RO_BINDS=("${OPT_RO[@]+"${OPT_RO[@]}"}")
    MODE=$mode PROFILE=$profile LABEL=$(sanitize_name "${OPT_LABEL:-}")
    write_config_file "$VT_CONFIG_DIR/$name.conf" "$name"
    printf 'saved %s\n' "$VT_CONFIG_DIR/$name.conf"
}
config_delete() {
    local name=${1:-}; [ -n "$name" ] || die "config delete needs a NAME"
    local f=$VT_CONFIG_DIR/$name.conf
    [ -f "$f" ] || die "no config '$name' in $VT_CONFIG_DIR (configs from other locations are not deleted here)"
    rm -f "$f" && printf 'deleted %s\n' "$f"
}

# --- ls: subdirectories, for a remote directory browser -------------------------
cmd_ls() {
    local dir=${1:-$HOME} porcelain=0
    [ "$dir" = "--porcelain" ] && { dir=$HOME; porcelain=1; }
    [ "${2:-}" = "--porcelain" ] && porcelain=1
    case "$dir" in "~") dir=$HOME ;; "~/"*) dir=$HOME/${dir#"~/"} ;; esac
    [ -d "$dir" ] || die "not a directory: $dir"
    dir=$(cd "$dir" && pwd -P)
    [ "$porcelain" -eq 1 ] && printf 'DIR=%s\n' "$dir"
    local d
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        if [ "$porcelain" -eq 1 ]; then printf '%s\n' "${d##*/}"; else printf '  %s/\n' "${d##*/}"; fi
    done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null | sort)
}

# --- doctor -----------------------------------------------------------------
cmd_doctor() {
    printf '%s== vibe-tunnel doctor ==%s\n' "$BOLD" "$RST"
    if [ "$VT_SHARED" -eq 1 ]; then
        echo "  install:     $VIBE_TUNNEL_DIR  (shared installation${VT_MAINTAINER:+, maintained by $VT_MAINTAINER}; not writable by you)"
        echo "               your own profiles go to $VT_USER_PROFILES (vibe-tunnel profiles edit|new)"
    else
        echo "  install:     $VIBE_TUNNEL_DIR  (your own checkout)"
    fi
    [ -f "$VT_SITE_ENV" ] && echo "  site env:    $VT_SITE_ENV"
    echo "  state dir:   $VT_STATE_DIR  (private: configs, profiles, logs, sandbox home)"
    echo "  configs:     $VT_CONFIG_DIR"
    echo
    if [ -e "$VT_IMAGE" ]; then
        ok "image: $VT_IMAGE ($(du -h "$VT_IMAGE" | cut -f1))"
        [ "$VT_IMAGE" != "${CLAUDE_MOBILE_IMAGE:-}" ] || warn "that is euler-vibe's image (fallback); build vibe-tunnel's own with ./setup.sh"
    
    elif [ "$VT_SHARED" -eq 1 ]; then warn "image missing: $VT_IMAGE  (ask the maintainer to run setup.sh in the installation)"
    else warn "image missing: $VT_IMAGE  (cd $VIBE_TUNNEL_DIR && module load eth_proxy && ./setup.sh)"; fi
    [ -f "$VT_SHELLRC" ] && ok "shellrc: $VT_SHELLRC" || warn "shellrc missing: $VT_SHELLRC"
    ok "default sandbox home: $VT_DEFAULT_HOME"
    [ -z "$EULER_VIBE_DIR" ] || ok "euler-vibe (optional): $EULER_VIBE_DIR"
    if [ -x "$VT_CODE_CLI" ]; then ok "VS Code CLI: $VT_CODE_CLI ($("$VT_CODE_CLI" --version 2>/dev/null | head -n1))"
    elif [ "$VT_SHARED" -eq 1 ]; then warn "VS Code CLI missing: $VT_CODE_CLI  (ask the maintainer to run setup.sh in the installation)"
    else warn "VS Code CLI missing: $VT_CODE_CLI  (run ./setup.sh)"; fi
    [ -n "$(vt_singularity)" ] && ok "singularity/apptainer on PATH" || warn "singularity/apptainer not on PATH (fine on a login node; jobs load it)"
    command -v sbatch >/dev/null 2>&1 && ok "slurm (sbatch) available" || warn "sbatch not found"
    if [ -n "${http_proxy:-}${HTTP_PROXY:-}" ]; then ok "proxy set: ${http_proxy:-$HTTP_PROXY}"
    else warn "no http_proxy in this shell (jobs run 'module load eth_proxy' themselves)"; fi
    local n m; n=$(ls "$VT_CONFIG_DIR"/*.conf 2>/dev/null | wc -l | tr -d ' '); m=$(ls "$CLAUDE_LAUNCH_CONFIG_DIR"/*.conf 2>/dev/null | wc -l | tr -d ' ')
    ok "saved configs: $n in $VT_CONFIG_DIR, $m from claude-launch"
    echo
    cmd_profiles
}

# --- main -------------------------------------------------------------------
cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
    launch)   cmd_launch "$@" ;;
    submit)   cmd_submit "$@" ;;
    claude)   cmd_run claude "$@" ;;
    shell)    cmd_run shell "$@" ;;
    wait)     cmd_wait "$@" ;;
    status)   cmd_status "$@" ;;
    show)     cmd_show "$@" ;;
    logs)     cmd_logs "$@" ;;
    stop)     cmd_stop "$@" ;;
    configs)  cmd_configs "$@" ;;
    config)   cmd_config "$@" ;;
    ls)       cmd_ls "$@" ;;
    profiles) cmd_profiles "$@" ;;
    doctor)   cmd_doctor "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown command '$cmd' (try: vibe-tunnel help)" ;;
esac
