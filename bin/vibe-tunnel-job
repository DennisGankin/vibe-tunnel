#!/usr/bin/env bash
set -euo pipefail

# vibe-tunnel-job -------------------------------------------------------------
# Host side of a run: resolves the sandbox (workspace, persistent home, extra
# binds) from a saved config and/or the run's env file, assembles the container
# invocation (bin/vibe-tunnel-lib) and starts bin/vibe-tunnel-entry inside it.
#
# Modes (VT_MODE):
#   tunnel  inside a slurm job: run `code tunnel` in the container; everything
#           printed lands in the slurm log (~/.vibe-tunnel/logs/<jobid>.log),
#           which `vibe-tunnel wait` polls for the VS Code tunnel link
#   claude  interactive, right here: Claude Code in the container, then a shell
#   shell   interactive, right here: a shell in the container
#
# Inputs (environment, set by `vibe-tunnel submit|claude|shell`):
#   VIBE_TUNNEL_DIR   this repo on the cluster
#   VT_ENV_FILE       per-run settings (VT_TUNNEL_NAME, VT_CONFIG, VT_CONFIG_FILE,
#                     VT_WORKSPACE, VT_HOME, VT_EXTENSIONS, VT_RW_BINDS, VT_RO_BINDS)
#   VT_STATE_DIR      ~/.vibe-tunnel (site settings in $VT_STATE_DIR/env)
# Remaining arguments are passed to the program in the container (claude mode).

log() { printf '[%s] vibe-tunnel: %s\n' "$(date '+%H:%M:%S')" "$*"; }
die() { log "ERROR: $*" >&2; exit 1; }

VIBE_TUNNEL_DIR=${VIBE_TUNNEL_DIR:-$HOME/vibe-tunnel}
# shellcheck disable=SC1091
. "$VIBE_TUNNEL_DIR/bin/vibe-tunnel-lib"
VT_MODE=${VT_MODE:-tunnel}
case "$VT_MODE" in tunnel|claude|shell) ;; *) die "unknown mode: $VT_MODE" ;; esac

# --- 1. per-run settings ----------------------------------------------------
VT_TUNNEL_NAME= VT_CONFIG= VT_CONFIG_FILE= VT_WORKSPACE= VT_HOME= VT_EXTENSIONS=
VT_RW_BINDS=() VT_RO_BINDS=()
if [ -n "${VT_ENV_FILE:-}" ]; then
    [ -f "$VT_ENV_FILE" ] || die "env file missing: $VT_ENV_FILE"
    env_is_valid "$VT_ENV_FILE" || die "env file has unexpected content: $VT_ENV_FILE"
    # shellcheck disable=SC1090
    . "$VT_ENV_FILE"
fi
vt_resolve_sandbox || exit 1
[ -z "$VT_CONFIG_FILE" ] || log "using saved config '${VT_CONFIG:-$VT_CONFIG_FILE}'"
TUNNEL_NAME=${VT_TUNNEL_NAME:-vibe-${SLURM_JOB_ID:-$$}}
EXTENSIONS=${VT_EXTENSIONS-anthropic.claude-code}

# --- 2. sanity checks -------------------------------------------------------
[ -e "$VT_IMAGE" ]  || die "container image missing: $VT_IMAGE (run setup.sh to build it)"
[ -f "$VT_ENTRY" ]  || die "entry script missing: $VT_ENTRY"
[ -d "$WORKSPACE" ] || die "workspace is not a directory: $WORKSPACE"
[ "$VT_MODE" != tunnel ] || [ -x "$VT_CODE_CLI" ] || die "VS Code CLI missing: $VT_CODE_CLI (run setup.sh)"
mkdir -p "$CLAUDE_MOBILE_HOME"

# Euler: outbound HTTPS (tunnel relay, server download, Anthropic API) needs the proxy.
if command -v module >/dev/null 2>&1; then
    module load eth_proxy 2>/dev/null || log "module eth_proxy not available; continuing with current proxy env"
fi
SINGULARITY=$(vt_singularity)
[ -n "$SINGULARITY" ] || die "neither singularity nor apptainer found on this node"

# /tmp inside the container: a per-run directory on local scratch (--writable-tmpfs is tiny).
VT_TMPDIR=${TMPDIR:-/tmp}/vibe-tunnel.${SLURM_JOB_ID:-$$}
mkdir -p "$VT_TMPDIR"
trap 'rm -rf "$VT_TMPDIR" 2>/dev/null || true' EXIT

# --- 3. container invocation -------------------------------------------------
vt_container_args
vt_container_env "VT_MODE=$VT_MODE" "VT_TUNNEL_NAME=$TUNNEL_NAME" "VT_JOB_ID=${SLURM_JOB_ID:-local}" \
    "VT_EXTENSIONS=$EXTENSIONS" "VT_HOST_WORKSPACE=$WORKSPACE" "VT_HOST_NODE=$(hostname -s)"

banner() {
    echo "================ vibe-tunnel ($VT_MODE) ================"
    echo "node       : $(hostname -s)${SLURM_JOB_ID:+  job $SLURM_JOB_ID}"
    echo "image      : $VT_IMAGE"
    echo "workspace  : $WORKSPACE  (same path in the container; also /workspace)"
    echo "home       : $CLAUDE_MOBILE_HOME  -> /home"
    echo "tmp        : $VT_TMPDIR  -> /tmp"
    for b in "${RW_BINDS[@]+"${RW_BINDS[@]}"}"; do echo "bind (rw)  : $b"; done
    for b in "${RO_BINDS[@]+"${RO_BINDS[@]}"}"; do echo "bind (ro)  : $b"; done
}

# --- 4. run -----------------------------------------------------------------
if [ "$VT_MODE" != tunnel ]; then
    banner >&2
    echo "=================================================" >&2
    exec "$SINGULARITY" exec "${CONTAINER_ARGS[@]}" "$VT_IMAGE" bash /opt/vibe-tunnel/entry "$@"
fi

banner
echo "code cli   : $VT_CODE_CLI"
echo "tunnel     : $TUNNEL_NAME"
echo "VT_TUNNEL_NAME=$TUNNEL_NAME"
echo "VT_WORKSPACE=$WORKSPACE"
echo "================================================="

# Forward SIGTERM (slurm time limit, scancel) into the container so the entry
# script can unregister the tunnel before the job dies.
child=
forward() { [ -n "$child" ] && kill -TERM "$child" 2>/dev/null || true; }
trap forward TERM INT
"$SINGULARITY" exec "${CONTAINER_ARGS[@]}" "$VT_IMAGE" bash /opt/vibe-tunnel/entry &
child=$!
# A trapped signal makes `wait` return early (>128) while the child is still
# shutting down, so keep waiting until it has really exited.
status=0
while :; do
    if wait "$child"; then status=0; break; fi
    status=$?
    kill -0 "$child" 2>/dev/null || break
done
log "container exited with status $status"
exit "$status"
