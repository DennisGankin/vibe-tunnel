#!/usr/bin/env bash
set -euo pipefail

# vibe-tunnel-job -------------------------------------------------------------
# Host side of a run: resolves the sandbox (workspace, persistent home, extra
# binds) from a saved config and/or the run's env file, then starts the run.
#
# Modes (VT_MODE):
#   tunnel  inside a slurm job: `code tunnel` in the container (bin/vibe-tunnel-entry);
#           everything printed lands in the slurm log (~/.vibe-tunnel/logs/<jobid>.log),
#           which `vibe-tunnel wait` polls for the VS Code tunnel link
#   node    inside a slurm job: `code tunnel` directly on the node, no container.
#           VS Code then works with your cluster home like a plain tunnel; the
#           sandbox is started from one of its terminals with `vibe-tunnel claude`,
#           which defaults to this job's sandbox settings (VT_NODE_ENV_FILE)
#   claude  interactive, right here: Claude Code in the container, then a shell
#   shell   interactive, right here: a shell in the container
#
# Inputs (environment, set by `vibe-tunnel submit|claude|shell`):
#   VIBE_TUNNEL_DIR   this repo on the cluster
#   VT_ENV_FILE       per-run settings (VT_TUNNEL_NAME, VT_CONFIG, VT_CONFIG_FILE,
#                     VT_WORKSPACE, VT_HOME, VT_EXTENSIONS, VT_RW_BINDS, VT_RO_BINDS)
#   VT_STATE_DIR      ~/.vibe-tunnel (site settings in $VT_STATE_DIR/env)
# Remaining arguments are passed to the program in the container (claude mode).

log() { printf '[%s] vibe-tunnel: %s\n' "$(date '+%H:%M:%S')" "$*"; }
die() { log "ERROR: $*" >&2; exit 1; }

VIBE_TUNNEL_DIR=${VIBE_TUNNEL_DIR:-$HOME/vibe-tunnel}
# shellcheck disable=SC1091
. "$VIBE_TUNNEL_DIR/bin/vibe-tunnel-lib"
VT_MODE=${VT_MODE:-tunnel}
case "$VT_MODE" in tunnel|node|claude|shell) ;; *) die "unknown mode: $VT_MODE" ;; esac

# --- 1. per-run settings ----------------------------------------------------
VT_TUNNEL_NAME= VT_CONFIG= VT_CONFIG_FILE= VT_WORKSPACE= VT_HOME= VT_EXTENSIONS=
VT_RW_BINDS=() VT_RO_BINDS=()
if [ -n "${VT_ENV_FILE:-}" ]; then
    [ -f "$VT_ENV_FILE" ] || die "env file missing: $VT_ENV_FILE"
    env_is_valid "$VT_ENV_FILE" || die "env file has unexpected content: $VT_ENV_FILE"
    # shellcheck disable=SC1090
    . "$VT_ENV_FILE"
fi
vt_resolve_sandbox || exit 1
[ -z "$VT_CONFIG_FILE" ] || log "using saved config '${VT_CONFIG:-$VT_CONFIG_FILE}'"
TUNNEL_NAME=${VT_TUNNEL_NAME:-vibe-${SLURM_JOB_ID:-$$}}
EXTENSIONS=${VT_EXTENSIONS-anthropic.claude-code}

# --- 2. sanity checks -------------------------------------------------------
[ -d "$WORKSPACE" ] || die "workspace is not a directory: $WORKSPACE"
if [ "$VT_MODE" != node ]; then
    [ -e "$VT_IMAGE" ]  || die "container image missing: $VT_IMAGE (run setup.sh to build it)"
    [ -f "$VT_ENTRY" ]  || die "entry script missing: $VT_ENTRY"
    mkdir -p "$CLAUDE_MOBILE_HOME"
fi
case "$VT_MODE" in tunnel|node) [ -x "$VT_CODE_CLI" ] || die "VS Code CLI missing: $VT_CODE_CLI (run setup.sh)" ;; esac

# Euler: outbound HTTPS (tunnel relay, server download, Anthropic API) needs the proxy.
if command -v module >/dev/null 2>&1; then
    module load eth_proxy 2>/dev/null || log "module eth_proxy not available; continuing with current proxy env"
fi
SINGULARITY=
if [ "$VT_MODE" != node ]; then
    SINGULARITY=$(vt_singularity)
    [ -n "$SINGULARITY" ] || die "neither singularity nor apptainer found on this node"
fi

# Scratch for this run on local scratch: /tmp inside the container (--writable-tmpfs
# is tiny), or the CLI's working dir in node mode. Unique per run, so several
# containers started in one job (vibe-tunnel claude in two terminals) never share
# or delete each other's.
VT_TMPDIR=${TMPDIR:-/tmp}/vibe-tunnel.${SLURM_JOB_ID:-local}.$$
mkdir -p "$VT_TMPDIR"
trap 'rm -rf "$VT_TMPDIR" 2>/dev/null || true' EXIT

# --- 3. container invocation -------------------------------------------------
vt_vscode_auth_dir
[ "$VT_MODE" = node ] || vt_container_args

# First run with the per-user VS Code login store: seed it from a login saved
# per sandbox home by earlier versions (this home, the default home, or any
# home a saved config points at), so nobody re-does the GitHub device login.
seed_vscode_login() {
    local store=${VT_VSCODE_AUTH:-$VT_STATE_DIR/vscode-auth}/token.json cand d f
    [ -f "$store" ] && return 0
    local homes=("$CLAUDE_MOBILE_HOME" "$VT_DEFAULT_HOME")
    for d in "$VT_CONFIG_DIR" "${VT_OLD_CONFIG_DIR:-}" "$CLAUDE_LAUNCH_CONFIG_DIR"; do
        [ -d "$d" ] || continue
        for f in "$d"/*.conf; do [ -f "$f" ] && config_is_valid "$f" && homes+=("$(config_field "$f" CLAUDE_MOBILE_HOME)"); done
    done
    for cand in "${homes[@]}"; do
        [ -n "$cand" ] && [ -f "$cand/.vscode-cli/token.json" ] || continue
        cp -f "$cand/.vscode-cli/token.json" "$store" && chmod 600 "$store" && log "VS Code login taken over from $cand" && return 0
    done
    return 0
}
seed_vscode_login
vt_container_env "VT_MODE=$VT_MODE" "VT_TUNNEL_NAME=$TUNNEL_NAME" "VT_JOB_ID=${SLURM_JOB_ID:-local}" \
    "VT_EXTENSIONS=$EXTENSIONS" "VT_HOST_WORKSPACE=$WORKSPACE" "VT_HOST_NODE=$(hostname -s)"

banner() {
    echo "================ vibe-tunnel ($VT_MODE) ================"
    echo "node       : $(hostname -s)${SLURM_JOB_ID:+  job $SLURM_JOB_ID}"
    if [ "$VT_MODE" = node ]; then
        echo "workspace  : $WORKSPACE"
        echo "container  : none. VS Code runs directly on the node with your cluster home."
        echo "             Sandbox from a terminal there:  vibe-tunnel claude   (or: vibe-tunnel shell)"
    else
        echo "image      : $VT_IMAGE"
        echo "workspace  : $WORKSPACE  (same path in the container; also /workspace)"
        echo "home       : $CLAUDE_MOBILE_HOME  -> /home"
        echo "tmp        : $VT_TMPDIR  -> /tmp"
    fi
    if [ -n "${SLURM_JOB_ID:-}" ]; then
        local tl; tl=$(squeue -h -j "$SLURM_JOB_ID" -o %l 2>/dev/null | head -n1 | awk '{print $1}' || true)
        echo "allocated  : ${SLURM_CPUS_PER_TASK:-?} cpus · ${SLURM_MEM_PER_CPU:-?} MB per cpu${SLURM_MEM_PER_NODE:+ (${SLURM_MEM_PER_NODE} MB total)} · gpus ${SLURM_JOB_GPUS:-${SLURM_GPUS:-none}} · time limit ${tl:-?} · partition ${SLURM_JOB_PARTITION:-?}"
    fi
    [ "$VT_MODE" = node ] && return 0
    for b in "${RW_BINDS[@]+"${RW_BINDS[@]}"}"; do echo "bind (rw)  : $b"; done
    for b in "${RO_BINDS[@]+"${RO_BINDS[@]}"}"; do echo "bind (ro)  : $b"; done
}

# --- 4. run -----------------------------------------------------------------
case "$VT_MODE" in claude|shell)
    banner >&2
    echo "=================================================" >&2
    # not exec: the EXIT trap has to remove this run's scratch dir afterwards
    status=0
    "$SINGULARITY" exec "${CONTAINER_ARGS[@]}" "$VT_IMAGE" bash /opt/vibe-tunnel/entry "$@" || status=$?
    exit "$status" ;;
esac

banner
echo "code cli   : $VT_CODE_CLI"
echo "tunnel     : $TUNNEL_NAME"
echo "VT_TUNNEL_NAME=$TUNNEL_NAME"
echo "VT_WORKSPACE=$WORKSPACE"
echo "VT_MODE=$VT_MODE"
echo "================================================="

if [ "$VT_MODE" = node ]; then
    what="node tunnel"
    # Terminals of this tunnel inherit the environment: keep vibe-tunnel on PATH
    # and remember this job's sandbox settings, so a bare `vibe-tunnel claude`
    # there starts the container with the workspace/home/binds chosen at launch.
    export PATH="$VIBE_TUNNEL_DIR/bin:$PATH"
    export VT_NODE_ENV_FILE=${VT_ENV_FILE:-}
    # No --server-data-dir: the CLI's default (~/.vscode-server in your cluster
    # home), i.e. the extensions and settings of an ordinary tunnel on the node.
    RUN=(env "CT_CODE_SRC=$VT_CODE_CLI" "CT_WORK=$VT_TMPDIR" "CT_CLI_ROOT=$VT_STATE_DIR/vscode-cli"
         "CT_TOKEN_STORE=$VT_VSCODE_AUTH" "CT_NAME=$TUNNEL_NAME" "CT_WORKSPACE=$WORKSPACE"
         "CT_EXTENSIONS=$EXTENSIONS" "CT_JOB_ID=${SLURM_JOB_ID:-local}" "CT_NODE=$(hostname -s)"
         bash "$VT_CODETUNNEL")
else
    what="container"
    RUN=("$SINGULARITY" exec "${CONTAINER_ARGS[@]}" "$VT_IMAGE" bash /opt/vibe-tunnel/entry)
fi

# Forward SIGTERM (slurm time limit, scancel) to the tunnel (into the container)
# so it can unregister before the job dies.
child=
forward() { [ -n "$child" ] && kill -TERM "$child" 2>/dev/null || true; }
trap forward TERM INT
"${RUN[@]}" &
child=$!
# A trapped signal makes `wait` return early (>128) while the child is still
# shutting down, so keep waiting until it has really exited.
status=0
while :; do
    if wait "$child"; then status=0; break; fi
    status=$?
    kill -0 "$child" 2>/dev/null || break
done
log "$what exited with status $status"
if [ "$status" -ne 0 ] && [ -n "${SLURM_JOB_ID:-}" ]; then
    # Make the failure readable without an sacct round trip.
    case "$status" in
        135|137) log "status $status means the $what was killed (SIGBUS/SIGKILL): almost always out of memory. Allocated: ${SLURM_MEM_PER_CPU:-?} MB per cpu x ${SLURM_CPUS_PER_TASK:-?} cpus. The first launch into a fresh sandbox home needs ~1 GB for the Claude install; raise 'Memory per CPU' (with a unit, e.g. 2G) in Resources." ;;
    esac
    sacct -j "$SLURM_JOB_ID" -P -o JobID,State,ExitCode,MaxRSS,ReqMem,Elapsed 2>/dev/null | sed 's/^/sacct: /' || true
fi
exit "$status"
