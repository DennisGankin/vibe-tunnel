# vibe-tunnel site defaults -- copy to site.env in the installation directory (gitignored).
# Sourced by every user before their own ~/.vibe-tunnel/env, which overrides it.
# Plain KEY=value bash assignments; $USER and $HOME refer to the user running vibe-tunnel.

# Who maintains this installation (shown by `vibe-tunnel doctor`)
VT_MAINTAINER="Firstname Lastname <email>"

# Container image, if not images/vibe-tunnel.sif inside the installation
# VT_IMAGE=/cluster/project/<group>/software/vibe-tunnel/images/vibe-tunnel.sif

# Where a user's sandbox home (Claude + VS Code logins, extensions) lives by default.
# Default: ~/.vibe-tunnel/home (private, in the cluster home). Project storage example:
# VT_DEFAULT_HOME=/cluster/project/<group>/$USER/vibe-tunnel-home

# Reuse an euler-vibe checkout's image and sandbox home instead
# EULER_VIBE_DIR=/cluster/project/<group>/software/euler-vibe
